    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-256_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-16_altform-lightunplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-20_altform-lightunplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-lightunplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-32_altform-lightunplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-256_altform-lightunplated.png" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\LumiereIcon.png" />
    <Content Include="Assets\LumiereIcon.ico" />
    <Content Include="Assets\Square44x44Logo.ico" />
    <Content Include="Assets\Lumiere1.png" />
    <Content Include="Assets\Lumiere2.png" />
    <Content Include="Assets\Icons\Lumiere_Dark_Blue.png" />
    <Content Include="Assets\Icons\Lumiere_Dark_Blue.ico" />
    <Content Include="Assets\Icons\Lumiere_Dark_Purple.png" />
    <Content Include="Assets\Icons\Lumiere_Dark_Purple.ico" />
    <Content Include="Assets\Icons\Lumiere_Dark_Teal.png" />
