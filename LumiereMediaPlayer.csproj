    <Content Include="Assets\Icons\Lumiere_Dark_Orange.png" />
    <Content Include="Assets\Icons\Lumiere_Dark_Orange.ico" />
    <Content Include="Assets\Icons\Lumiere_Dark_Red.png" />
    <Content Include="Assets\Icons\Lumiere_Dark_Red.ico" />
    <Content Include="Assets\Icons\Lumiere_Dark_Pink.png" />
