<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumiereMediaPlayer.Controls"
    xmlns:helpers="using:LumiereMediaPlayer.Helpers">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- 3D Convex Optical Lens Gradient for Light Mode (Simulating spherical glass curvature & refraction) -->
            <LinearGradientBrush x:Key="LiquidGlassLensBrush" StartPoint="0.5,0.0" EndPoint="0.5,1.0">
                <GradientStop Offset="0.0" Color="#D0FFFFFF" />
                <GradientStop Offset="0.10" Color="#55FFFFFF" />
                <GradientStop Offset="0.50" Color="#1EFFFFFF" />
                <GradientStop Offset="0.88" Color="#38FFFFFF" />
                <GradientStop Offset="1.0" Color="#75FFFFFF" />
            </LinearGradientBrush>

            <!-- 45-degree Directional Specular Fresnel Rim Highlight (Light Mode) -->
            <LinearGradientBrush x:Key="SpecularRimBorderBrush" StartPoint="0.0,0.0" EndPoint="1.0,1.0">
                <GradientStop Offset="0.0" Color="#F5FFFFFF" />
                <GradientStop Offset="0.30" Color="#75FFFFFF" />
                <GradientStop Offset="0.70" Color="#18000000" />
                <GradientStop Offset="1.0" Color="#60FFFFFF" />
            </LinearGradientBrush>

            <!-- 3D Liquid Glass Elevated Card Tile Fill -->
            <LinearGradientBrush x:Key="LiquidGlassCardBackgroundBrush" StartPoint="0.5,0.0" EndPoint="0.5,1.0">
                <GradientStop Offset="0.0" Color="#70FFFFFF" />
                <GradientStop Offset="0.25" Color="#25FFFFFF" />
                <GradientStop Offset="0.85" Color="#1AFFFFFF" />
                <GradientStop Offset="1.0" Color="#45FFFFFF" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="LiquidGlassControlFill" Color="#25FFFFFF" />
            <SolidColorBrush x:Key="LiquidGlassControlPointerOverFill" Color="#50FFFFFF" />
            <SolidColorBrush x:Key="LiquidGlassControlPressedFill" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="LiquidGlassSidebarBrush" Color="#10FFFFFF" />

        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- 3D Convex Optical Lens Gradient for Dark Mode (Smoky Obsidian Curvature) -->
            <LinearGradientBrush x:Key="LiquidGlassLensBrush" StartPoint="0.5,0.0" EndPoint="0.5,1.0">
                <GradientStop Offset="0.0" Color="#55FFFFFF" />
                <GradientStop Offset="0.12" Color="#25FFFFFF" />
                <GradientStop Offset="0.50" Color="#0EFFFFFF" />
                <GradientStop Offset="0.88" Color="#1AFFFFFF" />
                <GradientStop Offset="1.0" Color="#38FFFFFF" />
            </LinearGradientBrush>

            <!-- 45-degree Directional Specular Fresnel Rim Highlight (Dark Mode Silver Glint) -->
            <LinearGradientBrush x:Key="SpecularRimBorderBrush" StartPoint="0.0,0.0" EndPoint="1.0,1.0">
                <GradientStop Offset="0.0" Color="#A5FFFFFF" />
                <GradientStop Offset="0.30" Color="#35FFFFFF" />
                <GradientStop Offset="0.70" Color="#0AFFFFFF" />
                <GradientStop Offset="1.0" Color="#30FFFFFF" />
            </LinearGradientBrush>

            <!-- 3D Liquid Glass Elevated Card Tile Fill (Dark Mode) -->
            <LinearGradientBrush x:Key="LiquidGlassCardBackgroundBrush" StartPoint="0.5,0.0" EndPoint="0.5,1.0">
                <GradientStop Offset="0.0" Color="#35FFFFFF" />
                <GradientStop Offset="0.25" Color="#12FFFFFF" />
                <GradientStop Offset="0.85" Color="#0AFFFFFF" />
                <GradientStop Offset="1.0" Color="#22FFFFFF" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="LiquidGlassControlFill" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="LiquidGlassControlPointerOverFill" Color="#35FFFFFF" />
            <SolidColorBrush x:Key="LiquidGlassControlPressedFill" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="LiquidGlassSidebarBrush" Color="#08FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LiquidGlassLensBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SpecularRimBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LiquidGlassCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LiquidGlassControlFill" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="LiquidGlassControlPointerOverFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LiquidGlassControlPressedFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LiquidGlassSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Fallback resources for StaticResource resolution -->
    <SolidColorBrush x:Key="LiquidGlassSidebarBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="LiquidGlassControlFill" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="LiquidGlassControlPointerOverFill" Color="#45FFFFFF" />
    <SolidColorBrush x:Key="LiquidGlassControlPressedFill" Color="#12FFFFFF" />

    <LinearGradientBrush x:Key="SpecularRimBorderBrush" StartPoint="0.0,0.0" EndPoint="1.0,1.0">
        <GradientStop Offset="0.0" Color="#E5FFFFFF" />
        <GradientStop Offset="0.30" Color="#60FFFFFF" />
        <GradientStop Offset="0.70" Color="#15000000" />
        <GradientStop Offset="1.0" Color="#45FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidGlassLensBrush" StartPoint="0.5,0.0" EndPoint="0.5,1.0">
        <GradientStop Offset="0.0" Color="#D0FFFFFF" />
        <GradientStop Offset="0.10" Color="#55FFFFFF" />
        <GradientStop Offset="0.50" Color="#1EFFFFFF" />
        <GradientStop Offset="0.88" Color="#38FFFFFF" />
        <GradientStop Offset="1.0" Color="#75FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidGlassCardBackgroundBrush" StartPoint="0.5,0.0" EndPoint="0.5,1.0">
        <GradientStop Offset="0.0" Color="#70FFFFFF" />
        <GradientStop Offset="0.25" Color="#25FFFFFF" />
        <GradientStop Offset="0.85" Color="#1AFFFFFF" />
        <GradientStop Offset="1.0" Color="#45FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SpecularAccentRimBorderBrush" StartPoint="0.0,0.0" EndPoint="1.0,1.0">
        <GradientStop Offset="0.0" Color="#DDFF8C00" />
        <GradientStop Offset="1.0" Color="#44FF8C00" />
    </LinearGradientBrush>



    <!-- Glass Icon Button Style -->
    <Style x:Key="GlassIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource SpecularRimBorderBrush}" />
        <Setter Property="Background" Value="#1CFFFFFF" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="#38FFFFFF" />
                                        <Setter Target="RootBorder.BorderBrush" Value="#A0FFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="#15FFFFFF" />
                                        <Setter Target="RootBorder.BorderBrush" Value="#50FFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass Accent Pill Button Style (Primary Action / Play Button) -->
    <Style x:Key="GlassAccentPillButtonStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource SpecularAccentRimBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PillBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass Pill Action Button Style (Clear All, Open File, Actions) -->
    <Style x:Key="GlassPillButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="{ThemeResource LiquidGlassControlFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SpecularRimBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource LiquidGlassControlPointerOverFill}" />
                                        <Setter Target="RootBorder.BorderBrush" Value="#FFFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource LiquidGlassControlPressedFill}" />
                                        <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource SpecularRimBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimalist Glass Slider Style -->
    <Style x:Key="GlassSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="28" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
        <Setter Property="helpers:SliderHelper.MakeThumbCircular" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                        <Grid x:Name="HorizontalTemplate" MinHeight="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle
                                x:Name="HorizontalTrackRect"
                                Grid.ColumnSpan="3"
                                Height="4"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="#30FFFFFF"
                                Stroke="{StaticResource SpecularRimBorderBrush}"
                                StrokeThickness="1"
                                VerticalAlignment="Center" />
                            <Rectangle
                                x:Name="HorizontalDecreaseRect"
                                Grid.Column="0"
                                Height="4"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center" />
                            <Thumb
                                x:Name="HorizontalThumb"
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                CornerRadius="8"
                                Background="#FFFFFFFF"
                                BorderThickness="1"
                                BorderBrush="{StaticResource SpecularRimBorderBrush}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GlassContainer Default Control Template -->
    <Style TargetType="local:GlassContainer">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GlassContainer">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
