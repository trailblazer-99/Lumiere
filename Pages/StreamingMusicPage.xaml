<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumiereMediaPlayer.Pages.StreamingMusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LumiereMediaPlayer.Models.Streaming"
    xmlns:services="using:LumiereMediaPlayer.Services.Streaming"
    xmlns:helpers="using:LumiereMediaPlayer.Helpers"
    Loaded="OnPageLoaded">

    <Grid x:Name="PageContent" Margin="{StaticResource PageContentMargin}" Opacity="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D6;" FontSize="28" VerticalAlignment="Center"/>
                <TextBlock Text="Music" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Search and discover popular music, then listen on your favorite platform."
                       Style="{StaticResource PageSubtitleTextStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Pivot x:Name="MainPivot" Grid.Row="1" SelectionChanged="MainPivot_SelectionChanged">
            <!-- Discover Tab -->
            <PivotItem Header="Discover">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search & Filter Toolbar with Aligned Headers and Dimensions -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                <TextBlock Text="Search" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find" PlaceholderText="Search artists, songs, playlists..." TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchQuerySubmitted" Width="260" CornerRadius="8" Height="32"/>
                                    <ToggleButton x:Name="AiSearchToggle" IsChecked="{x:Bind ViewModel.IsAiSearchActive, Mode=TwoWay}" Checked="OnAiSearchToggleChecked" Unchecked="OnAiSearchToggleUnchecked" ToolTipService.ToolTip="Toggle AI Semantic Search" Height="32" Width="32" Padding="0" VerticalAlignment="Center" CornerRadius="8" helpers:SpringAnimationHelper.EnableHoverSpring="True">
                                        <FontIcon FontSize="13" Glyph="&#xED37;" x:Name="AiSearchIcon" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="FilterComboBox" Header="Filter by" ItemsSource="{x:Bind ViewModel.SearchFilters, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SearchFilter, Mode=TwoWay}" Width="150" CornerRadius="8" VerticalAlignment="Bottom" />
                            <ComboBox Header="Genre" ItemsSource="{x:Bind ViewModel.Genres, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGenre, Mode=TwoWay}" SelectionChanged="OnGenreSelectionChanged" Width="150" CornerRadius="8" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- GridView & State Views -->
                    <Grid Grid.Row="1">
                        <GridView x:Name="MusicGridView" ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTrackClicked">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem" BasedOn="{StaticResource RoundedCardGridViewItemStyle}" />
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:MusicApiTrack">
                                    <Border Width="200" Height="200" CornerRadius="12" Translation="0,0,8"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <Grid CornerRadius="12">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding HighResArtworkUrl}" Stretch="UniformToFill" />
                                            
                                            <!-- Hover Overlay -->
                                            <Border x:Name="HoverOverlay" Opacity="0.0" CornerRadius="12">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0.0"/>
                                                        <GradientStop Color="#95000000" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Border x:Name="PlayButtonIcon" Width="48" Height="48" CornerRadius="24" Background="#80000000" BorderBrush="#AAFFFFFF" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                                                        </Border.RenderTransform>
                                                        <FontIcon FontSize="20" Foreground="White" Glyph="&#xE768;" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Metadata Scrim -->
                                            <Border VerticalAlignment="Bottom" Height="78" CornerRadius="0,0,12,12">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="#B8000000" Offset="0.55"/>
                                                        <GradientStop Color="#F2000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel VerticalAlignment="Bottom" Padding="12,6,12,10" Spacing="1">
                                                    <TextBlock Text="{Binding TrackName}" Foreground="White" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplaySubtitle}" Foreground="#D1D5DB" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Media Type Badge -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,2" CornerRadius="4" Background="#CC000000" BorderThickness="1" BorderBrush="#33FFFFFF">
                                                <TextBlock Text="{Binding ResultType}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                            </Border>

                                            <!-- Streaming Platforms Pill Buttons -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Spacing="4">
                                                <HyperlinkButton NavigateUri="{Binding ExternalUrls.Spotify}" Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(HasSpotify), Mode=OneTime}" Width="28" Height="28" CornerRadius="14" Background="#CC000000" Padding="0" ToolTipService.ToolTip="Listen on Spotify">
                                                    <Image Width="20" Height="20" Stretch="Uniform" Source="https://www.google.com/s2/favicons?domain=spotify.com&amp;sz=128" />
                                                </HyperlinkButton>
                                                <HyperlinkButton NavigateUri="{Binding ExternalUrls.AppleMusic}" Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(HasAppleMusic), Mode=OneTime}" Width="28" Height="28" CornerRadius="14" Background="#CC000000" Padding="0" ToolTipService.ToolTip="Listen on Apple Music">
                                                    <FontIcon Glyph="&#xE93C;" FontSize="14" Foreground="#FA243C" />
                                                </HyperlinkButton>
                                                <HyperlinkButton NavigateUri="{Binding ExternalUrls.Tidal}" Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(HasTidal), Mode=OneTime}" Width="28" Height="28" CornerRadius="14" Background="#CC000000" Padding="0" ToolTipService.ToolTip="Listen on Tidal">
                                                    <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </HyperlinkButton>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Empty State Container -->
                        <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                    Visibility="{x:Bind GetDiscoverEmptyState(ViewModel.IsLoading), Mode=OneWay}">
                            <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8D6;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No music tracks found" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Try searching for a song, artist, album, or playlist." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Library Tab -->
            <PivotItem Header="Library">
                <Grid>
                    <GridView x:Name="LibraryGridView" IsItemClickEnabled="True" ItemClick="LibraryGridView_ItemClick" SelectionMode="None">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource RoundedCardGridViewItemStyle}" />
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="services:SavedStreamingItem">
                                <Border Width="200" Height="200" CornerRadius="12" Translation="0,0,8"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <Grid CornerRadius="12">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                        <Border x:Name="HoverOverlay" Opacity="0.0" CornerRadius="12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                                    <GradientStop Color="#95000000" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Border Width="48" Height="48" CornerRadius="24" Background="#80000000" BorderBrush="#AAFFFFFF" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <FontIcon FontSize="20" Foreground="White" Glyph="&#xE768;" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border VerticalAlignment="Bottom" Height="78" CornerRadius="0,0,12,12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="#B8000000" Offset="0.55"/>
                                                    <GradientStop Color="#F2000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Bottom" Padding="12,6,12,10" Spacing="1">
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#D1D5DB" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Empty State for Music Library -->
                    <StackPanel x:Name="LibraryEmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE734;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Your music library is empty" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Save tracks and albums from Discover to your library to access them here." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
