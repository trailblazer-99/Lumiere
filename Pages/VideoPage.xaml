<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumiereMediaPlayer.Pages.VideoPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumiereMediaPlayer.Pages"
    xmlns:models="using:LumiereMediaPlayer.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:LumiereMediaPlayer.Controls"
    xmlns:helpers="using:LumiereMediaPlayer.Helpers"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <Grid x:Name="PageContent" Margin="{StaticResource PageContentMargin}" RowSpacing="16" Opacity="1">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel x:Name="HeaderPanel" Spacing="8" Visibility="{x:Bind ViewModel.OverlayVisibility, Mode=OneWay}">
            <Grid x:Name="HeaderGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                    <RowDefinition x:Name="HeaderRow1" Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                    <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
                </Grid.ColumnDefinitions>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="HeaderLayoutStates">
                        <VisualState x:Name="WideHeader">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="641" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="NarrowHeader">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HeaderCol0.Width" Value="*" />
                                <Setter Target="HeaderCol1.Width" Value="*" />
                                <Setter Target="ControlsPanel.(Grid.Row)" Value="1" />
                                <Setter Target="ControlsPanel.(Grid.Column)" Value="0" />
                                <Setter Target="ControlsPanel.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="ControlsPanel.Margin" Value="0,16,0,0" />
                                <Setter Target="ControlsPanel.HorizontalAlignment" Value="Left" />
                                <Setter Target="TitlePanel.(Grid.ColumnSpan)" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <StackPanel x:Name="TitlePanel" Grid.Column="0" Grid.Row="0" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B2;" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Videos" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Watch videos with native Windows playback controls." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                
                <StackPanel x:Name="ControlsPanel" Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <AutoSuggestBox
                        Width="180"
                        PlaceholderText="Search videos..."
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                        VerticalAlignment="Bottom">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon Symbol="Find" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <ComboBox
                        Width="140"
                        Header="Filter By"
                        ItemsSource="{x:Bind ViewModel.FilterExtensionOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedFilterExtension, Mode=TwoWay}"
                        helpers:ComboBoxHelper.FollowBackdrop="True" />
                    <ToggleButton
                        Style="{StaticResource FavoritesFilterToggleButtonStyle}"
                        VerticalAlignment="Bottom"
                        IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                        AutomationProperties.Name="Filter to favorites only"
                        ToolTipService.ToolTip="Filter to favorites only" />
                    <ComboBox
                        Width="160"
                        Header="Sort By"
                        ItemsSource="{x:Bind ViewModel.SortOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                        helpers:ComboBoxHelper.FollowBackdrop="True" />
                        
                    <Button VerticalAlignment="Bottom" Command="{x:Bind ViewModel.AddFolderCommand}" AutomationProperties.Name="Add Folder" ToolTipService.ToolTip="Add folder to library">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                            <TextBlock Text="Add Folder" />
                        </StackPanel>
                    </Button>
                    <Button VerticalAlignment="Bottom" Command="{x:Bind ViewModel.AddFilesCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Open File(s)" ToolTipService.ToolTip="Open file(s)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            <TextBlock Text="Open File(s)" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearAllVideosButton" VerticalAlignment="Bottom" Click="OnClearAllVideosClick" AutomationProperties.Name="Clear all videos from library" ToolTipService.ToolTip="Clear all videos from library">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            <TextBlock Text="Clear All" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

                <!-- Main Library Gallery View -->
        <ScrollViewer x:Name="LibraryScrollViewer" Grid.Row="1" Visibility="{x:Bind ViewModel.OverlayVisibility, Mode=OneWay}" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredVideos, Mode=OneWay}" Margin="0,0,0,32">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="240" MinRowSpacing="16" MinColumnSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Style="{StaticResource CardButtonStyle}"
                            Click="OnVideoCardButtonClick">
                            <controls:MediaCard
                                Item="{Binding}"
                                IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                CardWidth="150"
                                CardHeight="225"
                                AccentColor="{Binding AccentColor}"
                                Artwork="{Binding Artwork}"
                                PosterUrl="{Binding PosterUrl}"
                                Subtitle="{Binding ReleaseYear}"
                                Title="{Binding Title}"
                                SelectionChanged="OnCardSelectionChanged" />
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state when no videos match -->
        <StackPanel x:Name="VideoEmptyState" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24">
            <FontIcon Glyph="&#xE8B2;" FontSize="48" HorizontalAlignment="Center" Opacity="0.6" />
            <TextBlock Text="No videos found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Add a folder or open files to build your video library." FontSize="14" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
            <Button Content="Add Folder" Command="{x:Bind ViewModel.AddFolderCommand}" HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="Add Folder" ToolTipService.ToolTip="Add folder to library" />
        </StackPanel>

        <!-- Floating Selection Action Ribbon for Video Library (strictly isolated to library view) -->
        <Grid
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.OverlayVisibility, Mode=OneWay}"
            IsHitTestVisible="{x:Bind ViewModel.ShowNoSourceOverlay, Mode=OneWay}"
            Canvas.ZIndex="100">
            <controls:SelectionRibbon
                x:Name="VideoSelectionRibbon"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                PlayRequested="OnVideoPlayRequested"
                PlayNextRequested="OnVideoPlayNextRequested"
                AddToQueueRequested="OnVideoAddToQueueRequested"
                SelectAllRequested="OnVideoSelectAllRequested"
                ClearRequested="OnVideoClearRequested"
                RemoveRequested="OnVideoRemoveRequested" />
        </Grid>

        <!-- Player & Sidebar Layout -->
        <Grid Grid.Row="1" ColumnSpacing="16" Visibility="{x:Bind ViewModel.PlayerVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Video player container -->
            <Border
                x:Name="VideoPlayerContainer"
                Grid.Column="0"
                Background="#FF000000"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource LargeCornerRadius}"
                DoubleTapped="OnVideoDoubleTapped"
                Tapped="OnVideoTapped"
                PointerWheelChanged="OnVideoPointerWheelChanged">
                <Grid x:Name="VideoPlayerHost" Background="#FF000000" SizeChanged="OnVideoPlayerHostSizeChanged">
                    <Rectangle Fill="Transparent" IsHitTestVisible="True" />

                    <!-- HDR Status Badge -->
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="16"
                        Padding="8,4"
                        CornerRadius="4"
                        Visibility="{x:Bind ViewModel.HdrBadgeVisibility, Mode=OneWay}"
                        Background="#CC000000">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE7DE;"
                                Foreground="{StaticResource HdrStatusGoldBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.HdrContentLabel, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource HdrStatusGoldBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Metadata Overlay -->
                    <Border
                        x:Name="MetadataOverlay"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="24,64,24,24"
                        Padding="20"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1"
                        Translation="0,0,32">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Border.BackgroundTransition>
                            <BrushTransition />
                        </Border.BackgroundTransition>
                        <Grid>
                            <Button x:Name="CloseMetadataButton" x:FieldModifier="public" 
                                    AutomationProperties.Name="Close metadata"
                                    ToolTipService.ToolTip="Close"
                                    Margin="0,-12,-12,0"
                                    Padding="4"
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top" 
                                    Background="Transparent"
                                    BorderBrush="Transparent">
                                <FontIcon Glyph="&#xE711;" FontSize="16" />
                            </Button>
                            
                            <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                                <StackPanel Spacing="24" MaxWidth="350">
                                    <!-- File Info -->
                                     <StackPanel Spacing="12">
                                         <TextBlock Text="File Information" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,4" />
                                         
                                         <Grid ColumnSpacing="20" RowSpacing="8">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="Auto" />
                                                 <ColumnDefinition Width="*" />
                                             </Grid.ColumnDefinitions>
                                             <Grid.RowDefinitions>
                                                 <RowDefinition />
                                                 <RowDefinition />
                                                 <RowDefinition />
                                                 <RowDefinition />
                                                 <RowDefinition />
                                                 <RowDefinition />
                                                 <RowDefinition />
                                                 <RowDefinition />
                                                 <RowDefinition />
                                                 <RowDefinition />
                                             </Grid.RowDefinitions>

                                             <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.CurrentVideo.Resolution, Mode=OneWay, FallbackValue='Unknown', TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                             <TextBlock Grid.Row="1" Grid.Column="0" Text="Aspect Ratio" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CurrentVideo.AspectRatio, Mode=OneWay, FallbackValue='16:9', TargetNullValue='16:9'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                             <TextBlock Grid.Row="2" Grid.Column="0" Text="Video Codec" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.CurrentVideo.Codec, Mode=OneWay, FallbackValue='Unknown', TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                             <TextBlock Grid.Row="3" Grid.Column="0" Text="HDR / Color" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.CurrentVideo.HdrFormat, Mode=OneWay, FallbackValue='SDR', TargetNullValue='SDR'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                             <TextBlock Grid.Row="4" Grid.Column="0" Text="Primary Audio" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.CurrentVideo.AudioFormat, Mode=OneWay, FallbackValue='Unknown', TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                             <TextBlock Grid.Row="5" Grid.Column="0" Text="Audio Streams" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.CurrentVideo.AudioTracksSummary, Mode=OneWay, FallbackValue='Unknown', TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                             <TextBlock Grid.Row="6" Grid.Column="0" Text="Subtitles" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.CurrentVideo.SubtitlesSummary, Mode=OneWay, FallbackValue='None', TargetNullValue='None'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                             <TextBlock Grid.Row="7" Grid.Column="0" Text="Bitrate / FPS" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                 <TextBlock Text="{x:Bind ViewModel.CurrentVideo.BitrateText, Mode=OneWay, FallbackValue='Unknown', TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                 <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                 <TextBlock Text="{x:Bind ViewModel.CurrentVideo.FrameRateText, Mode=OneWay, FallbackValue='Unknown', TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                             </StackPanel>

                                             <TextBlock Grid.Row="8" Grid.Column="0" Text="File Format" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                 <TextBlock Text="{x:Bind ViewModel.CurrentVideo.ContainerFormat, Mode=OneWay, FallbackValue='Unknown', TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                 <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                 <TextBlock Text="{x:Bind ViewModel.CurrentVideo.FileSizeText, Mode=OneWay, FallbackValue='Unknown', TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                             </StackPanel>

                                             <TextBlock Grid.Row="9" Grid.Column="0" Text="File Path" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                             <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind ViewModel.CurrentVideo.SourcePath, Mode=OneWay, FallbackValue='Unknown', TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" MaxWidth="220" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                         </Grid>
                                     </StackPanel>

                                    <!-- Internet Metadata Match -->
                                    <StackPanel x:Name="InternetMetadataPanel" Spacing="12" Visibility="Collapsed">
                                        <TextBlock Text="Internet Match" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <ProgressRing x:Name="InternetMetadataProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20,0,20" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        
                                        <Grid x:Name="InternetMetadataContent" ColumnSpacing="12" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="InternetMetadataPosterBorder" Grid.Column="0" CornerRadius="8" VerticalAlignment="Top" Visibility="Collapsed">
                                                <Image x:Name="InternetMetadataPoster" Width="90" Stretch="UniformToFill" MaxHeight="135" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                                                <TextBlock x:Name="InternetMetadataTitle" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="InternetMetadataOverview" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" LineHeight="16" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="InternetMetadataProvidersPanel" Spacing="8" Visibility="Collapsed">
                                            <Button x:Name="StreamingDetailsButton" x:FieldModifier="public" Content="Streaming" Padding="12,8" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" BorderBrush="Transparent" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Video list sidebar -->
            <Border
                x:Name="VideoListBorder"
                Grid.Column="1"
                CornerRadius="{StaticResource CardCornerRadiusFull}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="4">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="12,12,12,4">
                        <TextBlock Text="Up Next" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh video library" Style="{StaticResource TransportIconButtonStyle}">
                            <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                        </Button>
                    </Grid>
                    
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.FilteredVideos, Mode=OneWay}"
                        SelectionMode="None">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <Grid Padding="12,8" ColumnSpacing="12" Tapped="OnVideoItemTapped" RightTapped="OnVideoRowRightTapped" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Video Selection Checkbox -->
                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        Click="OnVideoTrackCheckBoxClicked"
                                        MinWidth="20"
                                        MinHeight="20"
                                        Padding="0"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Select video" />

                                      <!-- Video Poster Thumbnail -->
                                      <Border
                                          Grid.Column="1"
                                          Width="36"
                                          Height="54"
                                          CornerRadius="4"
                                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          VerticalAlignment="Center">
                                          <Grid>
                                              <FontIcon
                                                  FontSize="16"
                                                  Glyph="&#xE714;"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Opacity="0.5" />
                                              <Image Stretch="UniformToFill">
                                                  <Image.Source>
                                                      <BitmapImage UriSource="{Binding PosterUrl}" DecodePixelWidth="64" />
                                                  </Image.Source>
                                              </Image>
                                          </Grid>
                                      </Border>

                                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextStyle}"
                                                Text="{Binding Title}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                            <Border
                                                Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(HasLocationRep), Mode=OneWay}"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind SourcePath}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Text="{x:Bind LocationRep, Mode=OneWay}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource SubtleCaptionTextStyle}"
                                            Text="{Binding Artist}"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="3"
                                        AutomationProperties.Name="Play video"
                                        Click="OnVideoCardButtonClick"
                                        Style="{StaticResource TransportIconButtonStyle}"
                                        ToolTipService.ToolTip="Play">
                                        <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>


