<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumiereMediaPlayer.Pages.HomePage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LumiereMediaPlayer.Controls"
    xmlns:local="using:LumiereMediaPlayer.Pages"
    xmlns:models="using:LumiereMediaPlayer.Models"
    xmlns:helpers="using:LumiereMediaPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <Grid x:Name="RootLayoutGrid">
        <!-- Scrollable normal page content -->
        <ScrollViewer x:Name="HomeScrollViewer" Margin="0,48,0,0">
            <StackPanel x:Name="PageContent" Margin="32,0,32,24" Padding="0,0,0,80" Spacing="36" Opacity="1">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- Header Grid containing Brand/Greeting and Open file(s) button -->
                <Grid x:Name="HeaderGrid" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                        <RowDefinition x:Name="HeaderRow1" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                        <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="HeaderLayoutStates">
                            <VisualState x:Name="WideHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="641" />
                                </VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="NarrowHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="HeaderCol0.Width" Value="*" />
                                    <Setter Target="HeaderCol1.Width" Value="*" />
                                    <Setter Target="OpenFileButton.(Grid.Row)" Value="1" />
                                    <Setter Target="OpenFileButton.(Grid.Column)" Value="0" />
                                    <Setter Target="OpenFileButton.HorizontalAlignment" Value="Left" />
                                    <Setter Target="OpenFileButton.Margin" Value="0,16,0,0" />
                                    <Setter Target="GreetingPanel.(Grid.ColumnSpan)" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <!-- App Logo & Greeting Brand Section -->
                    <StackPanel x:Name="GreetingPanel" Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Image Width="64" Height="64" Source="ms-appx:///Assets/LumiereIcon.png" VerticalAlignment="Center" Stretch="Uniform" />
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="GreetingText"
                                Style="{StaticResource PageTitleTextStyle}"
                                FontSize="28" />
                            <TextBlock
                                Style="{StaticResource PageSubtitleTextStyle}"
                                Text="Pick up where you left off or explore your library." />
                        </StackPanel>
                    </StackPanel>

                    <!-- Open file(s) action button on the right -->
                    <SplitButton
                        x:Name="OpenFileButton"
                        Grid.Column="1"
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Open file(s)"
                        ToolTipService.ToolTip="Open file(s)"
                        helpers:SpringAnimationHelper.EnableHoverSpring="True"
                        helpers:SpringAnimationHelper.HoverScale="1.04"
                        Click="OnOpenFileClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE838;" />
                            <TextBlock Text="Open file(s)" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight" helpers:FlyoutHelper.FollowBackdrop="True" MenuFlyoutPresenterStyle="{StaticResource CinematicMenuFlyoutPresenterStyle}">
                                <MenuFlyoutItem Text="Open file..." Click="OnOpenFileMenuItemClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE890;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open folder..." Click="OnOpenFolderMenuItemClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </Grid>

                <!-- Recently played section -->
                <StackPanel x:Name="RecentSection" Spacing="16">
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Recently played" VerticalAlignment="Center" />
                        <Button
                            x:Name="ClearHistoryButton"
                            Content="Clear All"
                            Click="OnClearHistoryClick"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Clear recently played history"
                            ToolTipService.ToolTip="Clear recently played history"
                            helpers:SpringAnimationHelper.EnableHoverSpring="True"
                            helpers:SpringAnimationHelper.HoverScale="1.04"
                            Style="{StaticResource DefaultButtonStyle}" />
                    </Grid>
                    <ItemsRepeater x:Name="RecentItemsRepeater" ItemsSource="{Binding ViewModel.RecentlyPlayed, ElementName=PageRoot}" MaxHeight="4000">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinColumnSpacing="16"
                                MinItemHeight="290"
                                MinItemWidth="150"
                                MinRowSpacing="16"
                                Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Style="{StaticResource CardButtonStyle}"
                                    Click="OnMediaCardButtonClick">
                                    <controls:MediaCard
                                        Item="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        CardWidth="150"
                                        CardHeight="225"
                                        AccentColor="{Binding AccentColor}"
                                        Artwork="{Binding Artwork}"
                                        PosterUrl="{Binding PosterUrl}"
                                        Subtitle="{Binding Artist}"
                                        Title="{Binding Title}"
                                        SelectionChanged="OnCardSelectionChanged" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Empty state when no recently played items -->
                    <StackPanel x:Name="RecentEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="12" Padding="24,32">
                        <FontIcon Glyph="&#xE823;" FontSize="48" HorizontalAlignment="Center" Opacity="0.6" />
                        <TextBlock Text="Nothing played yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Open a file or browse your library to get started." FontSize="14" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnOpenFileMenuItemClick" AutomationProperties.Name="Open file" ToolTipService.ToolTip="Open file">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                    <TextBlock Text="Open file"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DefaultButtonStyle}" Click="OnOpenFolderMenuItemClick" AutomationProperties.Name="Open folder" ToolTipService.ToolTip="Open folder">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="16"/>
                                    <TextBlock Text="Open folder"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Favorite Videos section -->
                <StackPanel x:Name="FavoritesSection" Spacing="16" Visibility="{Binding ViewModel.FavoriteVideosVisibility, ElementName=PageRoot}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEB52;" FontSize="20" Foreground="{StaticResource FavoriteIconBrush}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Favorite Videos" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ItemsRepeater ItemsSource="{Binding ViewModel.FavoriteVideos, ElementName=PageRoot}" MaxHeight="4000">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinColumnSpacing="16"
                                MinItemHeight="290"
                                MinItemWidth="150"
                                MinRowSpacing="16"
                                Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Style="{StaticResource CardButtonStyle}"
                                    Click="OnMediaCardButtonClick">
                                    <controls:MediaCard
                                        Item="{Binding}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        CardWidth="150"
                                        CardHeight="225"
                                        AccentColor="{Binding AccentColor}"
                                        Artwork="{Binding Artwork}"
                                        PosterUrl="{Binding PosterUrl}"
                                        Subtitle="{Binding Artist}"
                                        Title="{Binding Title}"
                                        SelectionChanged="OnCardSelectionChanged" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Floating Open file(s) action button for Bottom Left and Bottom Right positions -->
        <SplitButton
            x:Name="FloatingOpenFileButton"
            VerticalAlignment="Bottom"
            Visibility="Collapsed"
            Canvas.ZIndex="50"
            AutomationProperties.Name="Open file(s)"
            ToolTipService.ToolTip="Open file(s)"
            helpers:SpringAnimationHelper.EnableHoverSpring="True"
            helpers:SpringAnimationHelper.HoverScale="1.04"
            Click="OnOpenFileClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE838;" />
                <TextBlock Text="Open file(s)" />
            </StackPanel>
            <SplitButton.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedLeft" helpers:FlyoutHelper.FollowBackdrop="True" MenuFlyoutPresenterStyle="{StaticResource CinematicMenuFlyoutPresenterStyle}">
                    <MenuFlyoutItem Text="Open file..." Click="OnOpenFileMenuItemClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE890;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open folder..." Click="OnOpenFolderMenuItemClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </SplitButton.Flyout>
        </SplitButton>

        <!-- Floating Selection Action Ribbon -->
        <controls:SelectionRibbon
            x:Name="HomeSelectionRibbon"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="24,0,24,16"
            Canvas.ZIndex="100"
            PlayRequested="OnHomePlayRequested"
            PlayNextRequested="OnHomePlayNextRequested"
            AddToQueueRequested="OnHomeAddToQueueRequested"
            SelectAllRequested="OnSelectAllRequested"
            ClearRequested="OnClearSelectionRequested"
            RemoveRequested="OnRemoveSelectedRequested" />
    </Grid>
</Page>



