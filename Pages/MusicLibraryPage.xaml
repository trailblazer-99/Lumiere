<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumiereMediaPlayer.Pages.MusicLibraryPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumiereMediaPlayer.Pages"
    xmlns:models="using:LumiereMediaPlayer.Models"
    xmlns:controls="using:LumiereMediaPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:LumiereMediaPlayer.Helpers"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <Grid x:Name="PageContent" Margin="{StaticResource PageContentMargin}" RowSpacing="20" Opacity="1">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header area -->
        <Grid x:Name="HeaderGrid" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow0" Height="Auto" />
                <RowDefinition x:Name="HeaderRow1" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HeaderCol0" Width="*" />
                <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
            </Grid.ColumnDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="HeaderLayoutStates">
                    <VisualState x:Name="WideHeader">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="850" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowHeader">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderCol0.Width" Value="*" />
                            <Setter Target="HeaderCol1.Width" Value="*" />
                            <Setter Target="ControlsGrid.(Grid.Row)" Value="1" />
                            <Setter Target="ControlsGrid.(Grid.Column)" Value="0" />
                            <Setter Target="ControlsGrid.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="ControlsGrid.Margin" Value="0,16,0,0" />
                            <Setter Target="TitlePanel.(Grid.ColumnSpan)" Value="2" />
                            
                            <Setter Target="ControlCol0.Width" Value="*" />
                            <Setter Target="ControlCol1.Width" Value="*" />
                            <Setter Target="SearchBox.(Grid.Row)" Value="1" />
                            <Setter Target="SearchBox.(Grid.Column)" Value="0" />
                            <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="SearchBox.Margin" Value="0,12,0,0" />
                            <Setter Target="SearchBox.Width" Value="340" />
                            <Setter Target="SearchBox.HorizontalAlignment" Value="Left" />
                            <Setter Target="ButtonsPanel.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel x:Name="TitlePanel" Grid.Column="0" Grid.Row="0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8D6;" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Music library" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Browse all tracks in your collection." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            
            <Grid x:Name="ControlsGrid" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ControlRow0" Height="Auto" />
                    <RowDefinition x:Name="ControlRow1" Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ControlCol0" Width="Auto" />
                    <ColumnDefinition x:Name="ControlCol1" Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Spacing="8" Grid.Column="0" Grid.Row="0">
                    <Button Command="{x:Bind ViewModel.AddFolderCommand}" AutomationProperties.Name="Add Folder" ToolTipService.ToolTip="Add folder to library">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock Text="Add Folder" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.AddFilesCommand}" AutomationProperties.Name="Add Files" ToolTipService.ToolTip="Add files to library">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            <TextBlock Text="Add Files" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh library and update unavailable titles">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.PlayTrackCommand}"
                            CommandParameter="{x:Bind TrackListView.SelectedItem, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="Play selected"
                            ToolTipService.ToolTip="Play selected track">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="16" />
                            <TextBlock Text="Play selected" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                    <AutoSuggestBox x:Name="SearchBox"
                                    Width="240"
                                    PlaceholderText="Search collection..."
                                    TextChanged="OnSearchBoxTextChanged"
                                    QuerySubmitted="OnSearchBoxQuerySubmitted"
                                    CornerRadius="4">
                        <AutoSuggestBox.QueryIcon>
                            <AnimatedIcon x:Name="SearchAnimatedIcon">
                                <AnimatedIcon.Source>
                                    <animatedvisuals:AnimatedFindVisualSource />
                                </AnimatedIcon.Source>
                                <AnimatedIcon.FallbackIconSource>
                                    <SymbolIconSource Symbol="Find" />
                                </AnimatedIcon.FallbackIconSource>
                            </AnimatedIcon>
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <ComboBox
                        Width="150"
                        Header="Sort By"
                        ItemsSource="{x:Bind ViewModel.SortOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                    <ToggleButton x:Name="AiSearchToggle" Checked="OnAiSearchToggleChecked" Unchecked="OnAiSearchToggleUnchecked" AutomationProperties.Name="Toggle AI Semantic Search" ToolTipService.ToolTip="Toggle AI Semantic Search" Height="32" Width="32" Padding="0" VerticalAlignment="Center">
                        <FontIcon FontSize="16" Glyph="&#xED37;" x:Name="AiSearchIcon" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </ToggleButton>
                    <Button x:Name="SaveAiPlaylistButton" Click="OnSaveAiPlaylistClick" AutomationProperties.Name="Save Playlist" ToolTipService.ToolTip="Save Search Results as AI Playlist" Height="32" Visibility="Collapsed" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8F4;"/>
                            <TextBlock Text="Save Playlist" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Genre Filter Strip -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableGenres, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Content="{Binding}"
                                Click="OnGenreButtonClick"
                                CornerRadius="16"
                                Padding="14,4"
                                FontSize="12" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Track list -->
        <Border
            x:Name="TrackListBorder"
            Grid.Row="2"
            CornerRadius="{StaticResource CardCornerRadiusFull}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="0">
            <ListView
                x:Name="TrackListView"
                DoubleTapped="OnTrackDoubleTapped"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                SelectionMode="Single">

                <ListView.Header>
                    <Grid
                        Padding="16,12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="HeaderSelectAllCheckBox"
                            Checked="OnHeaderSelectAllChecked"
                            Unchecked="OnHeaderSelectAllUnchecked"
                            MinWidth="20"
                            MinHeight="20"
                            Padding="0"
                            Margin="0"
                            ToolTipService.ToolTip="Select all"
                            VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TrackListHeaderTextStyle}" Text="TITLE" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TrackListHeaderTextStyle}" Text="ARTIST" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TrackListHeaderTextStyle}" Text="ALBUM" />
                        <TextBlock
                            Grid.Column="4"
                            Style="{StaticResource TrackListHeaderTextStyle}"
                            HorizontalAlignment="Right"
                            Text="TIME" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <Grid Padding="16,8" Tapped="OnTrackRowTapped" RightTapped="OnTrackRowRightTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <!-- Selection Checkbox -->
                            <CheckBox
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                Click="OnTrackCheckBoxClicked"
                                MinWidth="20"
                                MinHeight="20"
                                Padding="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                helpers:SpringAnimationHelper.EnableHoverSpring="True"
                                helpers:SpringAnimationHelper.HoverScale="1.1" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <Border
                                    Width="32"
                                    Height="32"
                                    CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                    <Grid CornerRadius="4">
                                        <FontIcon
                                            FontSize="12"
                                            Glyph="&#xE8D6;"
                                            Opacity="0.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Image Source="{x:Bind helpers:ImageBindHelper.SafeImageFromUrl(PosterUrl, 48), Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(HasLocationRep), Mode=OneWay}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind SourcePath, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind LocationRep, Mode=OneWay}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Artist, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="3"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Album, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="4"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Right"
                                Text="{x:Bind DurationText, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <!-- 3-Dot More Options Button -->
                            <Button
                                Grid.Column="5"
                                Click="OnTrackMoreClick"
                                Style="{StaticResource TransportIconButtonStyle}"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="More options"
                                ToolTipService.ToolTip="More options"
                                helpers:SpringAnimationHelper.EnableHoverSpring="True"
                                helpers:SpringAnimationHelper.HoverScale="1.15">
                                <FontIcon Glyph="&#xE712;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Empty state when no music tracks -->
        <StackPanel x:Name="MusicEmptyState" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24">
            <FontIcon Glyph="&#xE8D6;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Opacity="0.6" />
            <TextBlock Text="Your music library is empty" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Add folders or files to start building your collection." FontSize="14" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="Add Folder" Command="{x:Bind ViewModel.AddFolderCommand}" AutomationProperties.Name="Add Folder" ToolTipService.ToolTip="Add folder to library" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Add Files" Command="{x:Bind ViewModel.AddFilesCommand}" AutomationProperties.Name="Add Files" ToolTipService.ToolTip="Add files to library" Style="{StaticResource DefaultButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Floating Selection Action Ribbon -->
        <controls:SelectionRibbon
            x:Name="MusicSelectionRibbon"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Canvas.ZIndex="100"
            PlayRequested="OnMusicPlayRequested"
            PlayNextRequested="OnMusicPlayNextRequested"
            AddToQueueRequested="OnMusicAddToQueueRequested"
            SelectAllRequested="OnMusicSelectAllRequested"
            ClearRequested="OnMusicClearRequested"
            RemoveRequested="OnMusicRemoveRequested" />
    </Grid>
</Page>
