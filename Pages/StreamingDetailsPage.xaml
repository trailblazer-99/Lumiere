<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumiereMediaPlayer.Pages.StreamingDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumiereMediaPlayer.Pages"
    Loaded="OnPageLoaded"
    Unloaded="OnPageUnloaded">

    <Grid x:Name="PageContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Main Scrollable Details Area -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="24">

                <!-- Top Info Section: Backdrop Overlay & Basic Meta -->
                <Grid CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Padding="24" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Poster Column -->
                        <StackPanel Grid.Column="0" Spacing="12">
                            <Border Width="180" Height="270" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Image x:Name="PosterImage" Stretch="UniformToFill" />
                            </Border>
                            <Button x:Name="LibraryButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="LibraryMenuFlyout" Opening="OnLibraryFlyoutOpening">
                                        <MenuFlyoutItem Text="Watchlist" Click="OnSaveWatchlistClick" Tag="Watchlist" />
                                        <MenuFlyoutItem Text="Plan to Watch" Click="OnSaveWatchlistClick" Tag="Plan to Watch" />
                                        <MenuFlyoutItem Text="Watching" Click="OnSaveWatchlistClick" Tag="Watching" />
                                        <MenuFlyoutItem Text="Completed" Click="OnSaveWatchlistClick" Tag="Completed" />
                                        <MenuFlyoutItem Text="Favorites" Click="OnSaveWatchlistClick" Tag="Favorites" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="RemoveLibraryItem" Text="Remove from Library" Click="OnRemoveFromLibraryClick" Foreground="Red" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="LibraryIcon" Glyph="&#xE710;" FontSize="14"/>
                                    <TextBlock x:Name="LibraryButtonText" Text="Add to Watchlist" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Details Info Column -->
                        <StackPanel Grid.Column="1" Spacing="12">
                            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Border Background="{ThemeResource AccentButtonBackground}" CornerRadius="4" Padding="6,2,6,2" x:Name="TypeBadge">
                                    <TextBlock x:Name="TypeText" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock x:Name="YearText" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RatingText" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RuntimeText" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Margin="0,4,0,4">
                                <StackPanel x:Name="QualityBadgesPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />
                            </ScrollViewer>

                            <TextBlock x:Name="GenresText" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontStyle="Italic"/>
                            <TextBlock x:Name="NetworksText" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                            <StackPanel x:Name="ScoresPanel" Orientation="Horizontal" Spacing="12" Margin="0,4,0,4" Visibility="Collapsed">
                                <Border x:Name="RtScoreBorder" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="8,4,8,4" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🍅 RT" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="RtScoreText" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ImdbScoreBorder" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="8,4,8,4" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="⭐ IMDb" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="ImdbScoreText" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="CriticScoreBorder" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="8,4,8,4" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🎬 Critic" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="CriticScoreText" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="AudienceScoreBorder" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="8,4,8,4" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🍿 Audience" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AudienceScoreText" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="OverviewText" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,8"/>

                            <Button x:Name="TrailerButton" Click="OnTrailerButtonClick" Visibility="Collapsed" Style="{StaticResource DefaultButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock Text="Watch Trailer" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- "Where to Watch" Providers Section -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Where to Watch" Style="{StaticResource BodyLargeTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Country:" VerticalAlignment="Center" FontSize="12" Opacity="0.8"/>
                            <ComboBox x:Name="RegionDetailComboBox" Width="140" SelectedValuePath="Code" SelectionChanged="RegionDetailComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel x:Name="ProvidersContainer" Spacing="16">
                            <!-- Populated programmatically in code-behind -->
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Pivot for Cast, Crew, Episodes, Similar -->
                <Pivot x:Name="DetailsPivot">
                    <PivotItem x:Name="CastPivotItem" Header="Cast">
                        <GridView x:Name="CastGridView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CastGridView_ItemClick" Margin="0,12,0,0">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem" BasedOn="{StaticResource RoundedCardGridViewItemStyle}" />
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="220" Padding="12" Margin="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" ToolTipService.ToolTip="Click to view filmography">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Role}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </PivotItem>

                    <PivotItem x:Name="CrewPivotItem" Header="Crew">
                        <GridView x:Name="CrewGridView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CastGridView_ItemClick" Margin="0,12,0,0">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem" BasedOn="{StaticResource RoundedCardGridViewItemStyle}" />
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="220" Padding="12" Margin="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" ToolTipService.ToolTip="Click to view filmography">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Role}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </PivotItem>

                    <PivotItem x:Name="EpisodesPivotItem" Header="Seasons &amp; Episodes">
                        <TreeView x:Name="EpisodesTreeView" Margin="0,12,0,0">
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Margin="0,6,0,6">
                                        <TextBlock Text="{Binding Content.Title}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Content.Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding Content.SubtitleVisibility}" />
                                        <TextBlock Text="{Binding Content.Description}" FontSize="13" TextWrapping="Wrap" Opacity="0.8" Visibility="{Binding Content.DescriptionVisibility}" Margin="0,2,0,0" LineHeight="18" MaxWidth="700" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </PivotItem>

                    <PivotItem x:Name="SimilarPivotItem" Header="You May Also Like">
                        <GridView x:Name="SimilarTitlesGridView"
                                  Margin="0,16,0,0"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="SimilarTitlesGridView_ItemClick">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem" BasedOn="{StaticResource RoundedCardGridViewItemStyle}" />
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="140" Height="240" Margin="0">
                                        <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid CornerRadius="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Image Stretch="UniformToFill">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{Binding PosterUrl}" DecodePixelWidth="140" />
                                                    </Image.Source>
                                                </Image>
                                                <StackPanel Grid.Row="1" Padding="8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="0,0,12,12">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    <TextBlock Text="{Binding DisplayYear}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </PivotItem>

                    <PivotItem x:Name="ReleasesPivotItem" Header="Release Dates">
                        <ListView x:Name="ReleasesListView" Margin="0,16,0,0" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding DisplayType}" FontWeight="SemiBold" FontSize="14" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ReleaseDate}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" Padding="6,2,6,2">
                                                <TextBlock Text="{Binding Region}" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Platform}" FontSize="13" FontStyle="Italic" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </PivotItem>
                </Pivot>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
