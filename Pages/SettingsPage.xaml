                            <TextBlock Grid.Row="5" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ctrl + K"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12" Text="Cast to device"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="F11"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" FontSize="12" Text="Fullscreen"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Up / Down"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" FontSize="12" Text="Volume Up / Down"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 11. RESET & ABOUT -->
            <StackPanel x:Name="AboutSection" Spacing="2">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Reset &amp; About"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE7E6;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Reset settings"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Clear caches or reset all settings to factory defaults."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Reset history &amp; cache" Command="{x:Bind ViewModel.ResetHistoryAndCacheCommand}" Style="{StaticResource SettingsActionButtonStyle}" VerticalAlignment="Center"/>
                            <Button Content="Factory reset" Style="{StaticResource SettingsAccentActionButtonStyle}" Command="{x:Bind ViewModel.FactoryResetCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE895;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Check for updates"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Check for updates" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" Style="{StaticResource SettingsActionButtonStyle}" VerticalAlignment="Center"/>
                            <Button Content="Update Available" Style="{StaticResource SettingsAccentActionButtonStyle}" Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}" 
                                    Command="{x:Bind ViewModel.InstallUpdateCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="48" Height="48" Source="ms-appx:///Assets/LumiereIcon.png" VerticalAlignment="Top" Margin="0,2,0,0" Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Lumière Media Player"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Version 1.0  •  Built with WinUI 3 &amp; .NET 10" Margin="0,0,0,8"/>
                            
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <HyperlinkButton Grid.Row="0" Grid.Column="0" Content="Send feedback" Padding="0" MinHeight="0" FontSize="12" NavigateUri="https://github.com/trailblazer-99/Lumiere/issues"/>
                                <HyperlinkButton Grid.Row="0" Grid.Column="1" Content="Rate this app" Padding="0" MinHeight="0" FontSize="12" NavigateUri="ms-windows-store://review/?ProductId=LumiereMediaPlayer"/>
                                <HyperlinkButton Grid.Row="1" Grid.Column="0" Content="GitHub repository" Padding="0" MinHeight="0" FontSize="12" NavigateUri="https://github.com/trailblazer-99/Lumiere"/>
                                <HyperlinkButton Grid.Row="1" Grid.Column="1" Content="Open source licenses" Padding="0" MinHeight="0" FontSize="12" NavigateUri="https://github.com/trailblazer-99/Lumiere/blob/main/LICENSE"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
