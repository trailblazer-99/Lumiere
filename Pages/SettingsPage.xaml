                        <ToggleSwitch Grid.Column="2"                                                          OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ShowShuffleButton, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE8EE;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Show repeat button"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Display the repeat button in the transport controls."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                         OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ShowRepeatButton, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xED1E;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Show subtitles button"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Display the subtitles toggle in the transport controls."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                            OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ShowSubtitlesButton, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE740;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Show fullscreen button"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Display the fullscreen toggle in the transport controls."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                             OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ShowFullscreenButton, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE93A;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Show Picture in Picture button"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Display the PiP mini player button in the transport controls."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                      OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ShowPipButton, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE14C;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Show queue in more menu"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Include the playback queue option in the 3-dot menu."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                            OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ShowQueueInMoreMenu, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xEBE6;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Show speed controls in more menu"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Include playback speed options in the 3-dot menu."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                            OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ShowSpeedInMoreMenu, Mode=TwoWay}"/>
                    </Grid>
                </Border>
                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE8B7;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Show open files button on home page"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Display the Open file(s) button in the Home page greeting section."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                                                                   OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ShowOpenFilesOnHome, Mode=TwoWay}"/>
                    </Grid>
                </Border>


            </StackPanel>

            
            <StackPanel x:Name="LibrarySection" Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Media Library &amp; Files"/>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                                <FontIcon FontSize="16" Glyph="&#xE8B7;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="14" Text="Library folders"/>
                                <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Folders scanned for audio and video media files."/>
                            </StackPanel>
                            <Button Grid.Column="2" Click="OnAddFolderClick" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;"/>
                                    <TextBlock Text="Add folder"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.LibraryFolders, Mode=OneWay}" SelectionMode="None" Margin="0,4,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontSize="14" Glyph="&#xE838;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center" Text="{x:Bind}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Click="OnRemoveFolderClick" CommandParameter="{x:Bind}" AutomationProperties.Name="Remove folder" Background="Transparent" BorderThickness="0" CornerRadius="16" Height="32" Padding="8,0" Width="32" ToolTipService.ToolTip="Remove">
                                            <FontIcon FontSize="12" Glyph="&#xE711;"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE81A;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Automatic library scan on launch"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Scan media folders in the background when the app starts."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                             OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.AutomaticLibraryScan, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE8CB;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Sort library by"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Default sorting order for the media library view."/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="160"                                                                               VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.SelectedLibrarySortOrderIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Title"/>
                            <ComboBoxItem Content="Artist"/>
                            <ComboBoxItem Content="Date Added"/>
                            <ComboBoxItem Content="Duration"/>
                            <ComboBoxItem Content="Album"/>
                        </ComboBox>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE7B3;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Show hidden files"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Include hidden files in the media library scan."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                        OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ShowHiddenFiles, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE896;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Auto-import new files"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Automatically import new media files added to library folders."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                           OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.AutoImportNewFiles, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Top">
                            <FontIcon FontSize="16" Glyph="&#xE946;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock FontSize="14" Text="Supported formats"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Audio:"/>
                                <Run Text=" .mp3, .wav, .wma, .m4a, .flac, .ogg"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Video:"/>
                                <Run Text=" .mp4, .mkv, .avi, .mov, .wmv, .webm"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- AI Features -->
            <StackPanel x:Name="AiSection" Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="AI Features"/>

                <!-- Lyrics translation -->
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Enable lyrics translation"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Automatically translate synced lyrics on the Now Playing screen using AI."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="AiLyricsTranslationToggle" IsOn="False" Toggled="OnAiLyricsTranslationToggled" VerticalAlignment="Center" MinWidth="0"/>
                    </Grid>
                </Border>

                <!-- Translation Target Language -->
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE774;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Translation target language"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Select the language into which lyrics and subtitles should be translated."/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="AiTranslationLanguageComboBox" SelectionChanged="OnAiTranslationLanguageSelectionChanged" Width="150" VerticalAlignment="Center">
                            <ComboBoxItem Content="Hindi"/>
                            <ComboBoxItem Content="Spanish"/>
                            <ComboBoxItem Content="French"/>
                            <ComboBoxItem Content="German"/>
                            <ComboBoxItem Content="Japanese"/>
                            <ComboBoxItem Content="Chinese"/>
                            <ComboBoxItem Content="Russian"/>
                            <ComboBoxItem Content="Italian"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Semantic Search -->
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE75E;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Enable semantic search"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Use natural-language parsing for search queries in your music and video libraries."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="AiSemanticSearchToggle" IsOn="False" Toggled="OnAiSemanticSearchToggled" VerticalAlignment="Center" MinWidth="0"/>
                    </Grid>
                </Border>

                <!-- AI Equalizer Matcher -->
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE9E9;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="AI Equalizer Matcher"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Automatically detect and set equalizer presets based on track genre and details."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="AiEqualizerMatcherToggle" IsOn="False" Toggled="OnAiEqualizerMatcherToggled" VerticalAlignment="Center" MinWidth="0"/>
                    </Grid>
                </Border>

                <!-- Voice Clarity Enhancer -->
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE720;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Voice Clarity Enhancer"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Enable hardware-accelerated dialogue optimization for clearer spoken voice."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="VoiceClarityToggle" IsOn="False" Toggled="OnVoiceClarityToggled" VerticalAlignment="Center" MinWidth="0"/>
                    </Grid>
                </Border>

                <!-- Night Mode / Dynamic Volume -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE708;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Dynamic Volume Leveler (Night Mode)"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Level loud highlights and boost quiet dialogue for comfortable late-night viewing."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="NightModeToggle" IsOn="False" Toggled="OnNightModeToggled" VerticalAlignment="Center" MinWidth="0"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="PrivacySection" Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Privacy &amp; History"/>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE81C;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Remember recently played"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Keep a history of recently played media items."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                               OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.RememberRecentlyPlayed, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE8D3;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Remember playback position per track"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Store and resume the last playback position for each individual track."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                                         OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.RememberPlaybackPositionPerTrack, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE74D;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Clear data"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Clear playback history, search history, or recently opened files."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Playback history" Command="{x:Bind ViewModel.ClearPlaybackHistoryCommand}" VerticalAlignment="Center"/>
                            <Button Content="Search history" Command="{x:Bind ViewModel.ClearSearchHistoryCommand}" VerticalAlignment="Center"/>
                            <Button Content="Recent files" Command="{x:Bind ViewModel.ClearRecentFilesCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            
            <StackPanel x:Name="AccessibilitySection" Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Accessibility"/>

                
                <TextBlock Text="Vision" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE7F4;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="High contrast mode"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Increase contrast between UI elements for better visibility."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                         OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.HighContrastMode, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE8D2;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Large text mode"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Increase text size throughout the application."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                      OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.LargeTextMode, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE790;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Color blind mode"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Adjust colors for color vision deficiency."/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="160"                                                                             VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.SelectedColorBlindModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Off"/>
                            <ComboBoxItem Content="Protanopia (Red-Green)"/>
                            <ComboBoxItem Content="Deuteranopia (Green-Red)"/>
                            <ComboBoxItem Content="Tritanopia (Blue-Yellow)"/>
                        </ComboBox>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE7F5;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Screen reader optimization"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Optimize UI for screen reader compatibility."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                                 OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ScreenReaderOptimization, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE7B3;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Focus indicator thickness"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Adjust the thickness of focus indicators around controls."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Width="120" Minimum="1" Maximum="5" StepFrequency="1" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Value="{x:Bind ViewModel.FocusIndicatorThickness, Mode=TwoWay}"/>
                            <TextBlock Width="36" TextAlignment="Right" VerticalAlignment="Center" FontSize="13" Text="{x:Bind ViewModel.FocusIndicatorThicknessText, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                
                <TextBlock Text="Hearing" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xED1E;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Captions always on"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Automatically enable captions for all media."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                         OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.CaptionsAlwaysOn, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE706;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Visual notifications for sound"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Flash visual indicators when audio cues play."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                                    OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.VisualNotificationsForSound, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <TextBlock Text="Motor" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE765;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Keyboard navigation highlight"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Show visible focus indicators during keyboard navigation."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                                    OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.KeyboardNavigationHighlight, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE8B0;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Larger click targets"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Increase the size of buttons and interactive elements."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                           OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.LargerClickTargets, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE7AD;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Reduce motion"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Minimize animations and transitions throughout the app."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                     OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                
                <TextBlock Text="Cognitive" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>

                
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE7F6;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Auto-read controls"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Announce UI control labels when focused."/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"                                                         OnContent="" OffContent="" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.AutoReadControls, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </StackPanel>

            
            <StackPanel x:Name="ShortcutsSection" Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Keyboard Shortcuts"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Top">
                                <FontIcon FontSize="16" Glyph="&#xE765;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="14" Text="Available keyboard shortcuts" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="52,0,0,0" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Space"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Text="Play / Pause"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ctrl + Right"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Text="Skip forward"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ctrl + Left"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Text="Skip backward"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ctrl + I"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Text="Properties"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ctrl + Shift + E"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12" Text="Equaliser"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ctrl + K"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12" Text="Cast to device"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="F11"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" FontSize="12" Text="Fullscreen"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Up / Down"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" FontSize="12" Text="Volume Up / Down"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            
            <StackPanel x:Name="AboutSection" Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Reset &amp; About"/>

                
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource SmallCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE7E6;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="14" Text="Reset settings"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}" Text="Clear caches or reset all settings to factory defaults."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Reset history &amp; cache" Command="{x:Bind ViewModel.ResetHistoryAndCacheCommand}" VerticalAlignment="Center"/>
                            <Button Content="Factory reset" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.FactoryResetCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="36" Height="36" Source="ms-appx:///Assets/LumiereIcon.png" VerticalAlignment="Center" Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Lumière Media Player"/>
                            <TextBlock Style="{StaticResource SubtleCaptionTextStyle}"
                                       Text="Version 1.0  •  Built with WinUI 3 &amp; .NET 10"/>
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <HyperlinkButton Content="Send feedback" Padding="0" FontSize="12" NavigateUri="https://github.com/trailblazer-99/Lumiere/issues"/>
                                <HyperlinkButton Content="Rate this app" Padding="0" FontSize="12" NavigateUri="ms-windows-store://review/?ProductId=LumiereMediaPlayer"/>
                                <HyperlinkButton Content="GitHub repository" Padding="0" FontSize="12" NavigateUri="https://github.com/trailblazer-99/Lumiere"/>
                                <HyperlinkButton Content="Open source licenses" Padding="0" FontSize="12" NavigateUri="https://github.com/trailblazer-99/Lumiere/blob/main/LICENSE"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>


