<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumiereMediaPlayer.Pages.StreamingSportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LumiereMediaPlayer.Models.Streaming"
    mc:Ignorable="d">

    <Grid Margin="0,48,0,0">
        <!-- Main Content Area -->
        <Grid Padding="32,16,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Header Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border
                            Width="36"
                            Height="36"
                            CornerRadius="8"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon
                                Glyph="&#xF131;"
                                FontSize="18"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="Sports"
                            Style="{StaticResource TitleTextBlockStyle}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Text="Live scores, match schedules, and where to stream via Watchmode"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Search and Refresh controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <AutoSuggestBox
                        x:Name="SportsSearchBox"
                        Width="240"
                        Height="34"
                        PlaceholderText="Search teams, leagues..."
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        QueryIcon="Find"
                        VerticalAlignment="Center" />

                    <Button
                        Command="{x:Bind ViewModel.LoadEventsCommand}"
                        ToolTipService.ToolTip="Refresh scores &amp; schedules"
                        Height="34"
                        Width="36"
                        Padding="0"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. League Filter Chips -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled"
                Margin="0,0,0,20">
                <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableLeagues, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button
                                Content="{x:Bind}"
                                Click="OnLeagueFilterClick"
                                Tag="{x:Bind}"
                                CornerRadius="16"
                                Padding="14,6"
                                FontSize="13"
                                Style="{StaticResource DefaultButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3. Scrollable Content (Live Now & Upcoming Schedule) -->
            <ScrollViewer
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="28" Padding="0,0,0,32">

                    <!-- Live Now Section -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.LiveMatchesVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                            <TextBlock
                                Text="LIVE NOW"
                                FontWeight="Bold"
                                FontSize="14"
                                CharacterSpacing="80"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Live Match Cards Grid -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.LiveMatches, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="360" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WatchmodeLiveEvent">
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Margin="0,0,16,16"
                                        Padding="16"
                                        Tapped="OnMatchCardTapped">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- League Badge & Live Period -->
                                            <Grid Grid.Row="0">
                                                <Border
                                                    HorizontalAlignment="Left"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                    <TextBlock
                                                        Text="{x:Bind LeagueBadge}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Row="0"
                                                    HorizontalAlignment="Right"
                                                    Text="{x:Bind DisplayStatusText}"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Grid>

                                            <!-- Away Team -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind AwayTeam.DisplayName}"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center" />
                                                    <Button
                                                        Click="OnToggleFavoriteClick"
                                                        Tag="{x:Bind AwayTeam}"
                                                        Padding="4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center">
                                                        <FontIcon
                                                            Glyph="{x:Bind AwayTeam.FavoriteGlyph, Mode=OneWay}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Score.Away}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Home Team -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind HomeTeam.DisplayName}"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center" />
                                                    <Button
                                                        Click="OnToggleFavoriteClick"
                                                        Tag="{x:Bind HomeTeam}"
                                                        Padding="4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center">
                                                        <FontIcon
                                                            Glyph="{x:Bind HomeTeam.FavoriteGlyph, Mode=OneWay}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Score.Home}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Venue & Streams Row -->
                                            <TextBlock
                                                Grid.Row="3"
                                                Text="{x:Bind Venue}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- Watch Sources Action Button -->
                                            <Button
                                                Grid.Row="4"
                                                HorizontalAlignment="Stretch"
                                                Content="Where to Watch"
                                                Click="OnViewStreamsClick"
                                                Tag="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                CornerRadius="6"
                                                Padding="0,6"
                                                FontSize="13" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Upcoming Schedule Section -->
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Upcoming Schedule"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            FontWeight="SemiBold" />

                        <!-- Upcoming Match List -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.UpcomingMatches, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WatchmodeLiveEvent">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="OnViewStreamsClick"
                                        Tag="{x:Bind}"
                                        AutomationProperties.Name="{x:Bind DisplayTitle}"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,0,0,10"
                                        Padding="16,12">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Time & League Column -->
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind DisplayStatusText}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind LeagueBadge}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Matchup & Venue Column -->
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind DisplayTitle}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind Venue}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Watch Action Label -->
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="View Streams"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Error Banner -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Severity="Error"
                        Title="Unable to load live sports"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        IsClosable="False"
                        Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"
                        Margin="0,0,0,12" />

                    <!-- Empty State -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        Spacing="12"
                        Margin="0,48,0,0"
                        Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                        <Border
                            Width="56"
                            Height="56"
                            CornerRadius="28"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            HorizontalAlignment="Center">
                            <FontIcon
                                Glyph="&#xF131;"
                                FontSize="24"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="No sports events found"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Try selecting a different league filter or clearing your search query."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Loading Overlay -->
        <Grid
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.LoadingOverlayVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="40" Height="40" />
                <TextBlock
                    Text="Loading live sports &amp; streams..."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Where to Watch Slide-Over Sheet / Flyout -->
        <Grid
            x:Name="DetailsOverlay"
            Background="#66000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Tapped="OnDetailsScrimTapped"
            Visibility="{x:Bind ViewModel.DetailsOverlayVisibility, Mode=OneWay}">
            <Grid
                MaxWidth="420"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Panel Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock
                        Text="Where to Watch"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        FontWeight="Bold"
                        VerticalAlignment="Center" />
                    <Button
                        HorizontalAlignment="Right"
                        Click="OnCloseDetailsClick"
                        Padding="6"
                        Background="Transparent"
                        BorderThickness="0">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- Match Snapshot -->
                <Border
                    Grid.Row="1"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,20">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedEventTitle, Mode=OneWay}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedEventLeague, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedEventStatus, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stream Providers List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="AVAILABLE STREAMS &amp; CHANNELS"
                            FontSize="11"
                            FontWeight="Bold"
                            CharacterSpacing="60"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Margin="0,0,0,4" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedEventSources, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WatchmodeLiveSource">
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,0,0,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Source Details -->
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock
                                                        Text="{x:Bind FormattedType}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock
                                                        Text="{x:Bind Format}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Launch Link Button -->
                                            <Button
                                                Grid.Column="1"
                                                Click="OnOpenStreamSourceClick"
                                                Tag="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                CornerRadius="6"
                                                Padding="12,6"
                                                VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Watch" FontSize="13" />
                                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
