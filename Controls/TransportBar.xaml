<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LumiereMediaPlayer.Controls.TransportBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animatedvisuals="using:LumiereMediaPlayer.Controls"
    xmlns:helpers="using:LumiereMediaPlayer.Helpers"
    mc:Ignorable="d"
    Height="{StaticResource TransportBarHeight}">



    <Grid
        x:Name="BarGrid"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        Background="Transparent"
        Tapped="OnBarGridTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Progress bar row — full width -->
        <Grid x:Name="ProgressRowGrid" Grid.Row="0" Margin="16,6,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="ElapsedTimeText"
                Grid.Column="0"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="0:00"
                VerticalAlignment="Center"
                FontSize="12" />

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Slider
                    x:Name="ProgressSlider"
                    Maximum="100"
                    Padding="10,0,10,0"
                    IsThumbToolTipEnabled="False"
                    IsEnabled="False"
                    ValueChanged="OnProgressSliderValueChanged"
                    VerticalAlignment="Center">
                    <Slider.Resources>
                        <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
                    </Slider.Resources>
                </Slider>
                
                <!-- Hover Preview Popup -->
                <Popup x:Name="HoverPreviewPopup" IsLightDismissEnabled="False" IsHitTestVisible="False" VerticalOffset="-126">
                    <Border Background="{ThemeResource FlyoutPresenterBackground}" 
                            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="6"
                            Translation="0,0,16"
                            IsHitTestVisible="False">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <Border x:Name="HoverThumbnailBorder" CornerRadius="6" BorderThickness="0" Background="Transparent" Width="144" Height="81" Visibility="Collapsed">
                                <Image x:Name="HoverThumbnailImage" Width="144" Height="81" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock x:Name="HoverTimeText" Text="0:00" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <TextBlock
                x:Name="TotalTimeText"
                Grid.Column="2"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="0:00"
                VerticalAlignment="Center"
                FontSize="12" />
        </Grid>

        <!-- Controls row -->
        <Grid x:Name="ControlsRowGrid" Grid.Row="1" Padding="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Metadata -->
            <Button
                Grid.Column="0"
                Style="{StaticResource CardButtonStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="OnTrackClick">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="MiniAlbumArt"
                        Width="48"
                        Height="48"
                        CornerRadius="{StaticResource SmallCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon
                                x:Name="FallbackIcon"
                                FontSize="24"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8D6;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <Image
                                x:Name="ArtImage"
                                Stretch="UniformToFill"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                x:Name="TrackTitleText"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                MaxLines="1"
                                Text="No track selected"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                x:Name="TrackLocationBadge"
                                Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4,1"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TrackLocationText" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock
                            x:Name="TrackArtistText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            MaxLines="1"
                            Text="Choose something to play"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Center: Playback Buttons -->
            <StackPanel
                x:Name="CenterControlsPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Button
                    x:Name="ShuffleButton"
                    AutomationProperties.Name="Shuffle"
                    Click="OnShuffleClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Shuffle">
                    <FontIcon x:Name="ShuffleIcon" FontSize="16" Glyph="&#xE8B1;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <Button
                    x:Name="PreviousButton"
                    AutomationProperties.Name="Previous"
                    Click="OnPreviousClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Previous">
                    <FontIcon x:Name="PreviousIcon" FontSize="16" Glyph="&#xE892;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <Button
                    x:Name="SkipBackButton"
                    AutomationProperties.Name="Skip back 10 seconds"
                    Click="OnSkipBackClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Skip back 10 seconds">
                    <FontIcon x:Name="SkipBackIcon" FontSize="16" Glyph="&#xED3C;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button
                    x:Name="ReplayButton"
                    AutomationProperties.Name="Replay from beginning"
                    Click="OnReplayClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Replay from beginning"
                    VerticalAlignment="Center">
                    <FontIcon x:Name="ReplayIcon" FontSize="16" Glyph="&#xE72C;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>

                <!-- Play/Pause Button -->
                <Button
                    x:Name="PlayPauseButton"
                    AutomationProperties.Name="Play"
                    ToolTipService.ToolTip="Play"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Style="{StaticResource CleanPlayPauseButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    helpers:SpringAnimationHelper.PressScale="0.92"
                    Click="OnPlayPauseClick">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Animated Visual Player for background dynamic glow -->
                        <AnimatedVisualPlayer
                            x:Name="Player"
                            AutoPlay="False"
                            Width="44"
                            Height="44"
                            Opacity="0.4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <animatedvisuals:LottieLogo1/>
                        </AnimatedVisualPlayer>

                        <!-- Static Play/Pause FontIcon -->
                        <FontIcon
                            x:Name="PlayPauseIcon"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Glyph="&#xE768;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button
                    x:Name="StopButton"
                    AutomationProperties.Name="Stop"
                    Click="OnStopClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Stop"
                    VerticalAlignment="Center">
                    <FontIcon x:Name="StopIcon" FontSize="16" Glyph="&#xE71A;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <Button
                    x:Name="SkipForwardButton"
                    AutomationProperties.Name="Skip forward 30 seconds"
                    Click="OnSkipForwardClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Skip forward 30 seconds">
                    <FontIcon x:Name="SkipForwardIcon" FontSize="16" Glyph="&#xED3D;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button
                    x:Name="NextButton"
                    AutomationProperties.Name="Next"
                    Click="OnNextClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Next">
                    <FontIcon x:Name="NextIcon" FontSize="16" Glyph="&#xE893;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <Button
                    x:Name="RepeatButton"
                    AutomationProperties.Name="Repeat"
                    Click="OnRepeatClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Repeat">
                    <FontIcon x:Name="RepeatIcon" FontSize="16" Glyph="&#xE8EE;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
            </StackPanel>

            <!-- Right: Subtitles, Volume, PiP, Fullscreen, More -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                
                <Button
                    x:Name="AudioButton"
                    AutomationProperties.Name="Audio track"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Audio track">
                    <FontIcon x:Name="AudioIcon" FontSize="16" Glyph="&#xE8D6;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AudioMenuFlyout" Opening="OnAudioMenuOpening" helpers:FlyoutHelper.FollowBackdrop="True" MenuFlyoutPresenterStyle="{StaticResource CinematicMenuFlyoutPresenterStyle}">
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="SubtitlesButton"
                    AutomationProperties.Name="Subtitles"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Subtitles">
                    <FontIcon x:Name="SubtitlesIcon" FontSize="16" Glyph="&#xED1E;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="SubtitlesMenuFlyout" Opening="OnSubtitlesMenuOpening" helpers:FlyoutHelper.FollowBackdrop="True" MenuFlyoutPresenterStyle="{StaticResource CinematicMenuFlyoutPresenterStyle}">
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Volume Button with Slider Flyout -->
                <Button
                    x:Name="VolumeButton"
                    AutomationProperties.Name="Volume"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Volume">
                    <FontIcon x:Name="VolumeIcon" FontSize="16" Glyph="&#xE995;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Button.Flyout>
                        <Flyout x:Name="VolumeFlyout" Placement="Top" Opening="OnVolumeFlyoutOpening" Opened="OnVolumeFlyoutOpened" helpers:FlyoutHelper.FollowBackdrop="True">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                    <Setter Property="Padding" Value="12,8,12,8" />
                                    <Setter Property="Background" Value="{ThemeResource VolumeFlyoutPresenterBackground}" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource VolumeFlyoutPresenterBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="MinHeight" Value="48" />
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid Height="32" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>

                                <!-- Volume toggle button inside flyout -->
                                <Button
                                    x:Name="FlyoutVolumeButton"
                                    Grid.Column="0"
                                    Style="{StaticResource TransportIconButtonStyle}"
                                    AutomationProperties.Name="Volume"
                                    Click="OnVolumeClick"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Mute / Unmute">
                                    <FontIcon
                                        x:Name="FlyoutVolumeIcon"
                                        FontSize="16"
                                        Glyph="&#xE995;"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Button>

                                <!-- The volume slider -->
                                <Slider
                                    x:Name="VolumeSlider"
                                    Grid.Column="2"
                                    AutomationProperties.Name="Volume level"
                                    Width="130"
                                    Height="32"
                                    Padding="8,0,8,0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    IsThumbToolTipEnabled="False"
                                    ValueChanged="OnVolumeValueChanged"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">
                                    <Slider.Resources>
                                        <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
                                    </Slider.Resources>
                                </Slider>

                                <!-- Volume value text label -->
                                <TextBlock
                                    x:Name="VolumeValueText"
                                    Grid.Column="4"
                                    Text="100"
                                    MinWidth="36"
                                    TextAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="FullscreenButton"
                    AutomationProperties.Name="Fullscreen"
                    Click="OnFullscreenClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Fullscreen">
                    <FontIcon x:Name="FullscreenIcon" FontSize="16" Glyph="&#xE740;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>

                <!-- Picture in Picture (Mini Player) Button -->
                <Button
                    x:Name="PipButton"
                    AutomationProperties.Name="Picture in Picture"
                    Click="OnPipClick"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="Picture in Picture">
                    <FontIcon x:Name="PipIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE93A;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>

                <!-- More Options (3-dot) Button -->
                <Button
                    x:Name="MoreButton"
                    AutomationProperties.Name="More options"
                    Style="{StaticResource TransportIconButtonStyle}"
                    helpers:SpringAnimationHelper.EnableHoverSpring="True"
                    helpers:SpringAnimationHelper.HoverScale="1.08"
                    ToolTipService.ToolTip="More options">
                    <FontIcon x:Name="MoreIcon" FontSize="16" Glyph="&#xE712;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Top" Opening="OnMoreMenuOpening" helpers:FlyoutHelper.FollowBackdrop="True" MenuFlyoutPresenterStyle="{StaticResource CinematicMenuFlyoutPresenterStyle}">
                            <MenuFlyoutItem x:Name="MenuPropertiesItem" Text="Properties" Click="OnInfoClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="I" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                             <MenuFlyoutItem x:Name="MenuClipchampItem" Text="Edit with Clipchamp" Click="OnEditWithClipchampClick">
                                 <MenuFlyoutItem.Icon>
                                     <FontIcon Glyph="&#xE78B;" />
                                 </MenuFlyoutItem.Icon>
                             </MenuFlyoutItem>
                             <MenuFlyoutItem x:Name="MenuEqualiserItem" Text="Equaliser" Click="OnEqualiserClick">
                                 <MenuFlyoutItem.Icon>
                                     <FontIcon Glyph="&#xE9F9;" />
                                 </MenuFlyoutItem.Icon>
                                 <MenuFlyoutItem.KeyboardAccelerators>
                                     <KeyboardAccelerator Key="E" Modifiers="Control,Shift" />
                                 </MenuFlyoutItem.KeyboardAccelerators>
                             </MenuFlyoutItem>
                             
                             <MenuFlyoutSubItem x:Name="MenuSpeedSubItem" Text="Speed">
                                 <MenuFlyoutSubItem.Icon>
                                     <FontIcon Glyph="&#xEBE6;" />
                                 </MenuFlyoutSubItem.Icon>
                                 <RadioMenuFlyoutItem Text="0.25x" Click="OnSpeedClick" Tag="0.25" GroupName="PlaybackSpeedGroup" />
                                 <RadioMenuFlyoutItem Text="0.5x" Click="OnSpeedClick" Tag="0.5" GroupName="PlaybackSpeedGroup" />
                                 <RadioMenuFlyoutItem Text="0.75x" Click="OnSpeedClick" Tag="0.75" GroupName="PlaybackSpeedGroup" />
                                 <RadioMenuFlyoutItem Text="1.0x (Normal)" Click="OnSpeedClick" Tag="1.0" GroupName="PlaybackSpeedGroup" IsChecked="True" />
                                 <RadioMenuFlyoutItem Text="1.25x" Click="OnSpeedClick" Tag="1.25" GroupName="PlaybackSpeedGroup" />
                                 <RadioMenuFlyoutItem Text="1.5x" Click="OnSpeedClick" Tag="1.5" GroupName="PlaybackSpeedGroup" />
                                 <RadioMenuFlyoutItem Text="1.75x" Click="OnSpeedClick" Tag="1.75" GroupName="PlaybackSpeedGroup" />
                                 <RadioMenuFlyoutItem Text="2.0x" Click="OnSpeedClick" Tag="2.0" GroupName="PlaybackSpeedGroup" />
                             </MenuFlyoutSubItem>

                              <MenuFlyoutSubItem x:Name="MenuSleepTimerSubItem" Text="Sleep Timer">
                                  <MenuFlyoutSubItem.Icon>
                                      <FontIcon Glyph="&#xE708;" />
                                  </MenuFlyoutSubItem.Icon>
                                  <ToggleMenuFlyoutItem x:Name="SleepOffItem" Text="Off" Click="OnSleepTimerItemClick" Tag="0" IsChecked="True"/>
                                  <ToggleMenuFlyoutItem x:Name="Sleep15Item" Text="15 Minutes" Click="OnSleepTimerItemClick" Tag="15"/>
                                  <ToggleMenuFlyoutItem x:Name="Sleep30Item" Text="30 Minutes" Click="OnSleepTimerItemClick" Tag="30"/>
                                  <ToggleMenuFlyoutItem x:Name="Sleep60Item" Text="60 Minutes" Click="OnSleepTimerItemClick" Tag="60"/>
                                  <ToggleMenuFlyoutItem x:Name="SleepEndItem" Text="End of Current Track" Click="OnSleepTimerItemClick" Tag="end"/>
                              </MenuFlyoutSubItem>

                             <MenuFlyoutItem x:Name="MenuCastItem" Text="Cast to device" Click="OnCastToDeviceClick">
                                 <MenuFlyoutItem.Icon>
                                     <FontIcon Glyph="&#xEC15;" />
                                 </MenuFlyoutItem.Icon>
                                 <MenuFlyoutItem.KeyboardAccelerators>
                                     <KeyboardAccelerator Key="K" Modifiers="Control" />
                                 </MenuFlyoutItem.KeyboardAccelerators>
                             </MenuFlyoutItem>

                             <MenuFlyoutSubItem x:Name="AudioDevicesSubItem" Text="Audio output device">
                                 <MenuFlyoutSubItem.Icon>
                                     <FontIcon Glyph="&#xE7F6;" />
                                 </MenuFlyoutSubItem.Icon>
                             </MenuFlyoutSubItem>

                             <MenuFlyoutSubItem x:Name="MenuVideoSettingsSubItem" Text="Video settings">
                                 <MenuFlyoutSubItem.Icon>
                                     <FontIcon Glyph="&#xE714;" />
                                 </MenuFlyoutSubItem.Icon>
                                 <MenuFlyoutSubItem x:Name="MenuAspectRatioItem" Text="Aspect ratio" />
                                 <MenuFlyoutSubItem x:Name="MenuZoomItem" Text="Zoom" />
                             </MenuFlyoutSubItem>
                             <MenuFlyoutItem x:Name="MenuQueueItem" Text="Open queue" Click="OnQueueClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA37;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
