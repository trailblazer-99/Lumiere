<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LumiereMediaPlayer.Controls.TvEpisodeQueueCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumiereMediaPlayer.Controls"
    xmlns:models="using:LumiereMediaPlayer.Models"
    xmlns:helpers="using:LumiereMediaPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="240"
    Height="184"
    PointerEntered="OnCardPointerEntered"
    PointerExited="OnCardPointerExited">

    <Button
        x:Name="CardButton"
        Click="OnCardClicked"
        RightTapped="OnCardRightTapped"
        Padding="0"
        CornerRadius="10"
        BorderThickness="1.5"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        Background="Transparent"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        helpers:SpringAnimationHelper.EnableHoverSpring="True"
        helpers:SpringAnimationHelper.HoverScale="1.03"
        helpers:SpringAnimationHelper.PressScale="0.97">

        <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#22FFFFFF" />
        </Button.Resources>

        <Grid x:Name="CardContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="124" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 16:9 Thumbnail Area (Row 0) -->
            <Border
                Grid.Row="0"
                CornerRadius="9,9,0,0"
                Background="#16161A"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Grid>
                    <!-- Fallback Icon -->
                    <FontIcon
                        x:Name="FallbackIcon"
                        FontSize="28"
                        Glyph="&#xE714;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Opacity="0.4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                    <!-- Episode Still Image -->
                    <Image
                        x:Name="ThumbnailImage"
                        Stretch="UniformToFill"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

                    <!-- Ambient Scrim Gradients for Top/Bottom Badge Contrast -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <!-- Top Scrim -->
                        <Border Grid.Row="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#90000000" Offset="0.0" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Bottom Scrim -->
                        <Border Grid.Row="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.0" />
                                    <GradientStop Color="#90000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Top Badges Row -->
                    <Grid VerticalAlignment="Top" Margin="8,8,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Season & Episode Badge Pill -->
                        <Border
                            Grid.Column="0"
                            CornerRadius="4"
                            Background="#D0121216"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            Padding="6,2">
                            <TextBlock
                                x:Name="SeasonEpisodeBadgeText"
                                FontSize="10.5"
                                FontWeight="Bold"
                                Foreground="#FFFFFF" />
                        </Border>

                        <!-- Duration Pill -->
                        <Border
                            x:Name="DurationPill"
                            Grid.Column="2"
                            CornerRadius="4"
                            Background="#D0121216"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            Padding="6,2">
                            <TextBlock
                                x:Name="DurationBadgeText"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="#E0E0E0" />
                        </Border>
                    </Grid>

                    <!-- Center Play Overlay Circle -->
                    <Border
                        x:Name="PlayOverlay"
                        Width="38"
                        Height="38"
                        CornerRadius="19"
                        Background="#B016161C"
                        BorderBrush="#80FFFFFF"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <FontIcon
                            x:Name="PlayOverlayIcon"
                            FontSize="13"
                            Glyph="&#xF5B0;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Foreground="#FFFFFF"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- Bottom Status Badges: NOW PLAYING / UP NEXT / WATCHED -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8,0,0,8">

                        <!-- Now Playing Badge -->
                        <Border
                            x:Name="NowPlayingBadge"
                            Visibility="Collapsed"
                            CornerRadius="4"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Padding="6,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE768;" FontSize="9" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="PLAYING" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Up Next Badge -->
                        <Border
                            x:Name="UpNextBadge"
                            Visibility="Collapsed"
                            CornerRadius="4"
                            Background="#D0FF9800"
                            Padding="6,2">
                            <TextBlock Text="UP NEXT" FontSize="10" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center" />
                        </Border>

                        <!-- Watched Badge -->
                        <Border
                            x:Name="WatchedBadge"
                            Visibility="Collapsed"
                            CornerRadius="4"
                            Background="#D01B5E20"
                            Padding="6,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="#E8F5E9" VerticalAlignment="Center" />
                                <TextBlock Text="WATCHED" FontSize="10" FontWeight="SemiBold" Foreground="#E8F5E9" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Watched Resume Progress Bar (at bottom edge of thumbnail) -->
                    <Grid
                        x:Name="ProgressBarGrid"
                        Height="3"
                        VerticalAlignment="Bottom"
                        Background="#60000000"
                        Visibility="Collapsed">
                        <Border
                            x:Name="ProgressBarFill"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Metadata Info Area (Row 1) - Translucent Frosted Glass Backing -->
            <Border
                Grid.Row="1"
                CornerRadius="0,0,9,9"
                Background="#25000000"
                BorderThickness="0,1,0,0"
                BorderBrush="#15FFFFFF">
                <Grid Padding="10,6,10,6" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Episode Number & Title -->
                    <TextBlock
                        x:Name="TitleText"
                        Grid.Row="0"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />

                    <!-- Overview / Subtitle -->
                    <TextBlock
                        x:Name="OverviewText"
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                </Grid>
            </Border>
        </Grid>
    </Button>
</UserControl>
