<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LumiereMediaPlayer.Controls.VideoHoverPreviewHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Margin="0">

    <Grid x:Name="RootContainer" Background="{x:Null}">
        <!-- Full-window modal dismissal backdrop & cinematic dim scrim -->
        <Border
            x:Name="ModalDismissBackdrop"
            Background="#59000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Opacity="0"
            Visibility="Collapsed"
            PointerPressed="OnModalDismissBackdropPointerPressed"
            Tapped="OnModalDismissBackdropTapped" />

        <!-- Floating Netflix-Style Elevated Popout Card -->
        <Border
            x:Name="CardBorder"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="320"
            Height="296"
            CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Translation="0,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            PointerEntered="OnCardPointerEntered"
            PointerExited="OnCardPointerExited"
            PointerPressed="OnCardPointerPressed"
            RightTapped="OnCardRightTapped">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <Grid x:Name="CardContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MediaRowDefinition" Height="180" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ── Video / Media Display Area (Row 0) ── -->
                <Border
                    x:Name="MediaContainerBorder"
                    Grid.Row="0"
                    CornerRadius="7,7,0,0"
                    Background="#FF000000"
                    Tapped="OnMediaBannerTapped">
                    <Grid>
                        <!-- Previous Poster Image (for Cross-Fade Dissolve during Card Traversal) -->
                        <Border
                            x:Name="PreviousPosterBorder"
                            CornerRadius="7,7,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Opacity="0">
                            <Border.Background>
                                <ImageBrush
                                    x:Name="PreviousPosterBrush"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <!-- High-Res Poster Image (Instant Placeholder with Native Rounded Corners) -->
                        <Border
                            x:Name="PreviewPosterBorder"
                            CornerRadius="7,7,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <Border.Background>
                                <ImageBrush
                                    x:Name="PreviewPosterBrush"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <!-- Live Mini Video Player Element -->
                        <MediaPlayerElement
                            x:Name="PreviewVideoPlayer"
                            CornerRadius="7,7,0,0"
                            Stretch="Uniform"
                            AreTransportControlsEnabled="False"
                            AutoPlay="False"
                            Opacity="0"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

                        <!-- Top Scrim Gradient for Badge & Button Contrast -->
                        <Border
                            VerticalAlignment="Top"
                            Height="48"
                            CornerRadius="7,7,0,0"
                            IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#99000000" Offset="0.0" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Top Bar: Quality/HDR Badges -->
                        <Grid VerticalAlignment="Top" Margin="12,12,12,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- HDR Badge -->
                                <Border
                                    x:Name="HdrBadgeBorder"
                                    Background="#CC000000"
                                    BorderBrush="#40FFD700"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="HdrBadgeText"
                                        Text="HDR"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#FFD700" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Mute / Unmute Toggle Button (Netflix lower-right corner) -->
                        <Button
                            x:Name="MuteToggleButton"
                            AutomationProperties.Name="Toggle mute"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,8"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="16"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ToolTipService.ToolTip="Toggle mute"
                            Click="OnMuteToggleClicked"
                            Tapped="OnMuteToggleButtonTapped">
                            <FontIcon
                                x:Name="MuteIcon"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE74F;"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>

                        <!-- Scene Looper Progress Bar -->
                        <ProgressBar
                            x:Name="LoopProgressBar"
                            Height="2.5"
                            VerticalAlignment="Bottom"
                            Value="0"
                            Maximum="100"
                            Visibility="Collapsed"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Background="#33FFFFFF" />
                    </Grid>
                </Border>

                <!-- ── Metadata & Action Controls (Row 1) ── -->
                <Border
                    x:Name="MetadataContainerBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    MinHeight="104"
                    CornerRadius="0,0,7,7">
                    <Grid Padding="12,8,12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Title Text -->
                        <TextBlock
                            x:Name="TitleText"
                            Grid.Row="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Margin="0,0,0,4" />

                        <!-- Row 1: Netflix Quick Action Buttons Row -->
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <!-- Left: Play, Watchlist, Like, Multi-Select -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- Circular Play Button (Fluent Accent Style) -->
                                <Button
                                    x:Name="PlayButton"
                                    AutomationProperties.Name="Play"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    ToolTipService.ToolTip="Play"
                                    Click="OnPlayClicked">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Glyph="&#xF5B0;"
                                        FontSize="16"
                                        Margin="2,0,0,0"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Button>

                                <!-- Watchlist / Add to Queue Button -->
                                <Button
                                    x:Name="WatchlistButton"
                                    AutomationProperties.Name="Add to Watchlist"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="Add to Watchlist"
                                    Click="OnWatchlistClicked">
                                    <FontIcon
                                        x:Name="WatchlistIcon"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Glyph="&#xE710;"
                                        FontSize="16" />
                                 </Button>

                                <!-- Like / Favorite Button -->
                                <Button
                                    x:Name="FavoriteButton"
                                    AutomationProperties.Name="Like"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="Like"
                                    Click="OnFavoriteClicked">
                                    <FontIcon
                                        x:Name="FavoriteIcon"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Glyph="&#xEB51;"
                                        FontSize="16" />
                                </Button>

                                <!-- Selection Button -->
                                <Button
                                    x:Name="PreviewSelectButton"
                                    AutomationProperties.Name="Select"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="Select"
                                    Click="OnPreviewSelectClicked">
                                    <FontIcon
                                        x:Name="PreviewSelectIcon"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE762;" />
                                </Button>
                            </StackPanel>

                            <!-- Right: More Options & Close Button -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- 3-Dot More Options Button -->
                                <Button
                                    x:Name="MoreOptionsButton"
                                    AutomationProperties.Name="More options"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="More options"
                                    Click="OnMoreOptionsClicked">
                                    <FontIcon
                                        x:Name="MoreOptionsIcon"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE712;" />
                                </Button>

                                <!-- Netflix Dropdown / Expand Episodes Chevron Button -->
                                <Button
                                    x:Name="EpisodesDropdownButton"
                                    AutomationProperties.Name="Episodes and info"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="Expand"
                                    Visibility="Collapsed"
                                    Click="OnEpisodesDropdownClicked"
                                    PointerEntered="OnEpisodesDropdownPointerEntered"
                                    PointerExited="OnEpisodesDropdownPointerExited">
                                    <FontIcon
                                        x:Name="EpisodesDropdownIcon"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE70D;" />
                                </Button>

                                <!-- Close Button -->
                                <Button
                                    x:Name="CloseButton"
                                    AutomationProperties.Name="Close preview"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="Close preview"
                                    Click="OnCloseClicked">
                                    <FontIcon
                                        x:Name="CloseIcon"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Glyph="&#xE711;"
                                        FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Metadata Strip (Duration + Quality Badges) -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" VerticalAlignment="Center">
                            <!-- Seasons or Duration -->
                            <TextBlock
                                x:Name="DurationText"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />

                            <!-- Quality Pill (HD / 4K) -->
                            <Border
                                x:Name="QualityPillBorder"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4,4,4,4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="QualityPillText"
                                    Text="HD"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <!-- HDR Pill -->
                            <Border
                                x:Name="HdrPillBorder"
                                BorderBrush="#40FFD700"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4,4,4,4"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="HdrPillText"
                                    Text="HDR"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#FFD700" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Netflix Episodes Dropdown Section (Row 2) ── -->
                <Border
                    x:Name="EpisodesSectionBorder"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Background="Transparent"
                    CornerRadius="0,0,7,7">
                    <Grid Margin="12,4,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Netflix Episodes Header Strip -->
                        <Grid Grid.Row="0" Margin="0,4,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock
                                    Text="Episodes"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock
                                    x:Name="EpisodesCountSubtitle"
                                    Text="Season 1"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Horizontal Episodes Carousel / Strip with Navigation Chevrons -->
                        <Grid Grid.Row="1">
                            <ScrollViewer
                                x:Name="EpisodesScrollViewer"
                                HorizontalScrollMode="Enabled"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Disabled"
                                ViewChanged="OnEpisodesScrollViewerViewChanged"
                                PointerWheelChanged="OnEpisodesScrollViewerPointerWheelChanged">
                                <StackPanel
                                    x:Name="EpisodesListPanel"
                                    Orientation="Horizontal"
                                    Spacing="16" />
                            </ScrollViewer>

                            <!-- Left Scroll Chevron Button -->
                            <Button
                                x:Name="ScrollEpisodesLeftButton"
                                AutomationProperties.Name="Previous episodes"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="28"
                                Height="48"
                                Padding="0"
                                Margin="-4,0,0,0"
                                CornerRadius="4"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ToolTipService.ToolTip="Previous episodes"
                                Visibility="Collapsed"
                                Click="OnScrollEpisodesLeftClicked">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE76B;"
                                    FontSize="16" />
                            </Button>

                            <!-- Right Scroll Chevron Button -->
                            <Button
                                x:Name="ScrollEpisodesRightButton"
                                AutomationProperties.Name="Next episodes"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="28"
                                Height="48"
                                Padding="0"
                                Margin="0,0,-4,0"
                                CornerRadius="4"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ToolTipService.ToolTip="Next episodes"
                                Visibility="Collapsed"
                                Click="OnScrollEpisodesRightClicked">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE76C;"
                                    FontSize="16" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Top Border Stroke Overlay -->
                <Border
                    Grid.RowSpan="3"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
