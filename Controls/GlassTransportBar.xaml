<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LumiereMediaPlayer.Controls.GlassTransportBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumiereMediaPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
        <!-- Floating Glass Container Pill with Elevation Shadow -->
        <Border
            x:Name="PillContainer"
            CornerRadius="28"
            Translation="0,0,32"
            HorizontalAlignment="Center">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <local:GlassContainer
                x:Name="GlassSurface"
                Preset="UltraThinPill"
                Height="68"
                MinWidth="680"
                MaxWidth="920">

                <!-- 1px Specular Fresnel Border Overlay -->
                <Border
                    x:Name="RimBorder"
                    CornerRadius="28"
                    BorderThickness="1"
                    Background="Transparent"
                    BorderBrush="{StaticResource SpecularRimBorderBrush}">

                    <Grid Padding="20,0" ColumnSpacing="16" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />  <!-- Play / Pause / Skip -->
                            <ColumnDefinition Width="*" />     <!-- Scrub Slider & Markers -->
                            <ColumnDefinition Width="Auto" />  <!-- Time Display -->
                            <ColumnDefinition Width="Auto" />  <!-- Volume / Pip / Fullscreen -->
                        </Grid.ColumnDefinitions>

                        <!-- Playback Controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                x:Name="PrevButton"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Click="OnPreviousClicked">
                                <FontIcon Glyph="&#xE892;" FontSize="16" />
                            </Button>

                            <Button
                                x:Name="PlayPauseButton"
                                Style="{StaticResource GlassAccentPillButtonStyle}"
                                Width="44"
                                Height="44"
                                Click="OnPlayPauseClicked">
                                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" />
                            </Button>

                            <Button
                                x:Name="NextButton"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Click="OnNextClicked">
                                <FontIcon Glyph="&#xE893;" FontSize="16" />
                            </Button>
                        </StackPanel>

                        <!-- Seek Slider with Chapter Markers Canvas -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Canvas x:Name="ChapterMarkersCanvas" Height="4" HorizontalAlignment="Stretch" IsHitTestVisible="False" />
                            <Slider
                                x:Name="ScrubSlider"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Padding="8,0,8,0"
                                Style="{StaticResource GlassSliderStyle}"
                                ValueChanged="OnScrubSliderValueChanged" />
                        </Grid>

                        <!-- Time Indicator -->
                        <TextBlock
                            x:Name="TimeTextBlock"
                            Grid.Column="2"
                            Text="00:00 / 00:00"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" />

                        <!-- Volume & Extras -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                x:Name="MuteButton"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Click="OnMuteClicked">
                                <FontIcon Glyph="&#xE767;" FontSize="16" />
                            </Button>

                            <Slider
                                x:Name="VolumeSlider"
                                Width="84"
                                Value="80"
                                Maximum="100"
                                Padding="8,0,8,0"
                                Style="{StaticResource GlassSliderStyle}"
                                ValueChanged="OnVolumeSliderValueChanged"
                                VerticalAlignment="Center" />

                            <Button
                                x:Name="FullscreenButton"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Click="OnFullscreenClicked">
                                <FontIcon Glyph="&#xE740;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </local:GlassContainer>
        </Border>
    </Grid>
</UserControl>
