<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWinUI>true</UseWinUI>
    <IsPackable>false</IsPackable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkAutoInitializeNeeded>false</WindowsAppSdkAutoInitializeNeeded>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64;ARM64</Platforms>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.8.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.8.3" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LumiereMediaPlayer.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <Reference Include="LumiereMediaPlayer">
      <HintPath Condition="Exists('..\..\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.19041.0\win-$(Platform)\LumiereMediaPlayer.dll')">..\..\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.19041.0\win-$(Platform)\LumiereMediaPlayer.dll</HintPath>
      <HintPath Condition="!Exists('..\..\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.19041.0\win-$(Platform)\LumiereMediaPlayer.dll') and Exists('..\..\bin\x64\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\LumiereMediaPlayer.dll')">..\..\bin\x64\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\LumiereMediaPlayer.dll</HintPath>
      <HintPath Condition="!Exists('..\..\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.19041.0\win-$(Platform)\LumiereMediaPlayer.dll') and !Exists('..\..\bin\x64\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\LumiereMediaPlayer.dll') and Exists('..\..\bin\x64\Release\net10.0-windows10.0.19041.0\win-x64\LumiereMediaPlayer.dll')">..\..\bin\x64\Release\net10.0-windows10.0.19041.0\win-x64\LumiereMediaPlayer.dll</HintPath>
      <HintPath Condition="!Exists('..\..\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.19041.0\win-$(Platform)\LumiereMediaPlayer.dll') and !Exists('..\..\bin\x64\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\LumiereMediaPlayer.dll') and !Exists('..\..\bin\x64\Release\net10.0-windows10.0.19041.0\win-x64\LumiereMediaPlayer.dll')">..\..\bin\x64\Debug\net10.0-windows10.0.19041.0\win-x64\LumiereMediaPlayer.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
