                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        RequestedTheme="Dark"
                        Foreground="White"
                        helpers:SpringAnimationHelper.EnableHoverSpring="True"
                        helpers:SpringAnimationHelper.HoverScale="1.08"
                        helpers:SpringAnimationHelper.PressScale="0.92"
                        PointerEntered="OnFullscreenBackButtonPointerEntered"
                        PointerExited="OnFullscreenBackButtonPointerExited"
                        Click="OnVideoBackButtonClick"
                        Tapped="OnControlsTapped"
                        DoubleTapped="OnControlsDoubleTapped"
                        ToolTipService.ToolTip="Back">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3DFFFFFF" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White" />
                        </Button.Resources>
                        <AnimatedIcon x:Name="FullscreenBackAnimatedIcon" Width="16" Height="16" Foreground="White">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedBackVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Back" Foreground="White" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>
                </Grid>

                <!-- Middle: transparent, lets taps through to the video -->
                <Grid Grid.Row="1" Background="Transparent" IsHitTestVisible="False"/>

                <!-- Bottom transport controls slot -->
                <Grid Grid.Row="2" Background="Transparent">
                    <!-- TransportBar is reparented here at runtime via FullscreenTransportHost -->
                    <Border x:Name="FullscreenTransportHost" />
                </Grid>
            </Grid>

                                                <!-- Metadata Overlay -->
            <Border
                x:Name="FullscreenMetadataOverlay"
                x:FieldModifier="public"
                RequestedTheme="Dark"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24,64,24,96"
                Padding="20"
                CornerRadius="12"
                Visibility="Collapsed"
                Background="#E610141C"
                BorderBrush="{ThemeResource SpecularRimBorderBrush}"
                BorderThickness="1"
                Canvas.ZIndex="60"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Button x:Name="CloseFullscreenMetadataButton" x:FieldModifier="public" 
                            AutomationProperties.Name="Close metadata"
                            Margin="0,-12,-12,0"
                            Padding="4"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top" 
                            Background="Transparent"
                            BorderBrush="Transparent">
                        <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="White" />
                    </Button>
                    
                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel Spacing="12" MaxWidth="350">
                    <TextBlock Text="File Information" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="White" />
                    
                    <Grid ColumnSpacing="20" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" Foreground="#D0FFFFFF" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.Resolution, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Aspect Ratio" Foreground="#D0FFFFFF" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.AspectRatio, Mode=OneWay, TargetNullValue='16:9'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Video Codec" Foreground="#D0FFFFFF" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.Codec, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="HDR / Color" Foreground="#D0FFFFFF" FontSize="12" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.HdrFormat, Mode=OneWay, TargetNullValue='SDR'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFD700" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Primary Audio" Foreground="#D0FFFFFF" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.AudioFormat, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Audio Streams" Foreground="#D0FFFFFF" FontSize="12" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.AudioTracksSummary, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Subtitles" Foreground="#D0FFFFFF" FontSize="12" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.SubtitlesSummary, Mode=OneWay, TargetNullValue='None'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Bitrate / FPS" Foreground="#D0FFFFFF" FontSize="12" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.BitrateText, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="&#x2022;" FontSize="12" Foreground="#80FFFFFF" />
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.FrameRateText, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="File Format" Foreground="#D0FFFFFF" FontSize="12" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.ContainerFormat, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="&#x2022;" FontSize="12" Foreground="#80FFFFFF" />
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.FileSizeText, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="File Path" Foreground="#D0FFFFFF" FontSize="12" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.SourcePath, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" MaxWidth="260" TextWrapping="Wrap" Foreground="White" />
                    </Grid>

                    <!-- Divider between File Information and Internet Match -->
                    <MenuFlyoutSeparator Margin="0,8,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" x:Name="FullscreenMetadataDivider" x:FieldModifier="public" Visibility="Collapsed" />

                    <!-- Internet Metadata Match (syncs with normal mode's metadata side panel) -->
                    <StackPanel x:Name="FullscreenInternetMetadataPanel" x:FieldModifier="public" Spacing="12" Visibility="Collapsed" Width="300">
                        <TextBlock Text="Internet Match" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="White" />
                        <ProgressRing x:Name="FullscreenInternetMetadataProgress" x:FieldModifier="public" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20,0,20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        
                        <Grid x:Name="FullscreenInternetMetadataContent" x:FieldModifier="public" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="FullscreenInternetMetadataPosterBorder" x:FieldModifier="public" Grid.Column="0" CornerRadius="8" VerticalAlignment="Top" Visibility="Collapsed">
                                <Image x:Name="FullscreenInternetMetadataPoster" x:FieldModifier="public" Width="90" Stretch="UniformToFill" MaxHeight="130" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock x:Name="FullscreenInternetMetadataTitle" x:FieldModifier="public" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" />
                                <TextBlock x:Name="FullscreenInternetMetadataOverview" x:FieldModifier="public" FontSize="12" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" LineHeight="16" Foreground="#E0FFFFFF" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="FullscreenInternetMetadataProvidersPanel" x:FieldModifier="public" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="FullscreenStreamingDetailsButton" x:FieldModifier="public" Content="Streaming" Padding="12,8" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" BorderBrush="Transparent" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>







            <!-- Fullscreen Edge Seek Overlays (10s & Exponential Skip) -->
            <Grid x:Name="FullscreenSeekOverlayHost" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                <!-- Seek Backward Overlay (Left) -->
                <Border
                    x:Name="FullscreenSeekBackOverlay"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="64,0,0,0"
                    Padding="28,20"
                    CornerRadius="32"
                    Background="#B31A1A1A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Opacity="0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xED3C;" FontSize="32" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock x:Name="FullscreenSeekBackText" Text="-10s" FontSize="28" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FullscreenSeekBackSubtext" Text="Seek Backward" FontSize="14" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- Seek Forward Overlay (Right) -->
                <Border
                    x:Name="FullscreenSeekForwardOverlay"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,64,0"
                    Padding="28,20"
                    CornerRadius="32"
                    Background="#B31A1A1A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Opacity="0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock x:Name="FullscreenSeekForwardText" Text="+10s" FontSize="28" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xED3D;" FontSize="32" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FullscreenSeekForwardSubtext" Text="Seek Forward" FontSize="14" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <controls:TransportBar
            x:Name="TransportControls"
            Grid.Row="1"
            Canvas.ZIndex="590"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited"
            PointerWheelChanged="OnTransportControlsPointerWheelChanged"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom" />

        <!-- Mini Player View (CompactOverlay / PiP Mode) -->
        <Grid
            x:Name="MiniPlayerGrid"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="500"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            PointerMoved="OnMiniPlayerPointerMoved"
            PointerEntered="OnMiniPlayerPointerEntered"
            PointerExited="OnMiniPlayerPointerExited"
            PointerPressed="OnMiniPlayerPointerPressed"
            DoubleTapped="OnMiniPlayerDoubleTapped"
            Tapped="OnMiniPlayerTapped">

