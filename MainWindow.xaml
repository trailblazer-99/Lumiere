                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,38,0,0"
                    Spacing="8">
                    <!-- Hero Cover Art Card (105x105px with Specular Rim & ThemeShadow) -->
                    <Border
