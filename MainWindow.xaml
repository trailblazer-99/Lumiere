                <Image
                    x:Name="MiniAudioArtBlurred"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Stretch="UniformToFill"
                    Opacity="0.45" />
                
                <!-- Dark Vignette over ambient art -->
