                        Height="105"
                        CornerRadius="10"
                        HorizontalAlignment="Center"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        Translation="0,2,12">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <FontIcon
