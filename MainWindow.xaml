<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LumiereMediaPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LumiereMediaPlayer.Controls"
    xmlns:helpers="using:LumiereMediaPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LumiereMediaPlayer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    mc:Ignorable="d"
    Title="Lumière Media Player">


    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="OnRootGridDragOver"
          Drop="OnRootGridDrop"
          Loaded="OnWindowLoaded"
          PointerWheelChanged="OnRootGridPointerWheelChanged"
          PointerMoved="OnRootGridPointerMoved"
          PointerPressed="OnRootGridPointerPressed"
          PointerReleased="OnRootGridPointerReleased"
          PointerCanceled="OnRootGridPointerCanceled"
          PointerCaptureLost="OnRootGridPointerCanceled">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left Pane Navigation and Content Frame -->
        <NavigationView
            x:Name="RootNavigationView"
            x:FieldModifier="public"
            Grid.Row="0"
            IsTabStop="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="256"
            CompactPaneLength="48"
            ItemInvoked="OnNavigationItemInvoked"
            SelectionChanged="OnNavigationSelectionChanged"
            BackRequested="OnBackRequested"
            PaneOpened="OnNavigationPaneOpened"
            PaneClosed="OnNavigationPaneClosed"
            PaneOpening="OnNavigationPaneOpening"
            PaneClosing="OnNavigationPaneClosing"
            DisplayModeChanged="OnNavigationDisplayModeChanged"
            Loaded="OnRootNavigationViewLoaded">

            <NavigationView.PaneHeader>
                <Grid Height="40" VerticalAlignment="Center" Margin="6,0,0,0">
                    <StackPanel x:Name="PaneBrandPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image x:Name="TitleBarBrandIcon" Width="18" Height="18" UseLayoutRounding="True" Source="ms-appx:///Assets/Icons/Lumiere_Dark_Blue_small.png" VerticalAlignment="Center" Stretch="Uniform" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Lumière Media Player"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="AppSearchBox"
                    PlaceholderText="Search music, videos, streaming..."
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchQuerySubmitted"
                    SuggestionChosen="OnSearchSuggestionChosen">
                    <AutoSuggestBox.QueryIcon>
                        <AnimatedIcon x:Name="SearchAnimatedIcon">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedFindVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Find" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentMargin">0</Thickness>
                <x:Double x:Key="NavigationViewHeaderMinHeight">0</x:Double>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

                <!-- NavigationView Content straight edge (boundary of menu and pages) -->
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <CornerRadius x:Key="NavigationViewMinimalContentGridCornerRadius">0</CornerRadius>
                <CornerRadius x:Key="TopNavigationViewContentGridCornerRadius">0</CornerRadius>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="TopNavigationViewContentGridBorderThickness">0</Thickness>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                <x:Double x:Key="NavigationViewItemSelectionIndicatorWidth">0</x:Double>
                <x:Double x:Key="NavigationViewItemSelectionIndicatorHeight">0</x:Double>

                <Style x:Key="StreamingFlyoutItemButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="ItemRootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemRootBorder.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemRootBorder.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="ItemRootBorder.Opacity" Value="0.4" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Streaming Flyout for Collapsed / Compact Sidebar Mode (Fluent 2 Acrylic) -->
                <Flyout
                    x:Name="StreamingCompactFlyout"
                    x:Key="StreamingCompactFlyout"
                    Placement="RightEdgeAlignedTop"
                    ShouldConstrainToRootBounds="False"
                    Opening="OnStreamingCompactFlyoutOpening"
                    Opened="OnStreamingCompactFlyoutOpened"
                    helpers:FlyoutHelper.FollowBackdrop="True">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                            <Setter Property="MinWidth" Value="196" />
                            <Setter Property="MaxWidth" Value="240" />
                            <Setter Property="Padding" Value="4,6,4,6" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Background" Value="{ThemeResource FlyoutPresenterBackground}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>

                    <StackPanel x:Name="StreamingFlyoutContainer" Spacing="4" Orientation="Vertical">
                        <!-- Music -->
                        <Button
                            x:Name="FlyoutStreamMusicBtn"
                            Style="{StaticResource StreamingFlyoutItemButtonStyle}"
                            Tag="streamMusic"
                            Click="OnStreamMusicFlyoutClick"
                            PointerEntered="OnFlyoutItemPointerEntered"
                            PointerPressed="OnFlyoutItemPointerPressed">
                            <Grid Height="36" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle
                                    x:Name="FlyoutMusicIndicator"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="16"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="1,0,0,0"
                                    Visibility="Collapsed" />

                                <FontIcon
                                    Grid.Column="1"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE8D6;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="Music"
                                    FontSize="14"
                                    Margin="8,0,12,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- Movies -->
                        <Button
                            x:Name="FlyoutStreamMoviesBtn"
                            Style="{StaticResource StreamingFlyoutItemButtonStyle}"
                            Tag="streamMovies"
                            Click="OnStreamMoviesFlyoutClick"
                            PointerEntered="OnFlyoutItemPointerEntered"
                            PointerPressed="OnFlyoutItemPointerPressed">
                            <Grid Height="36" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle
                                    x:Name="FlyoutMoviesIndicator"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="16"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="1,0,0,0"
                                    Visibility="Collapsed" />

                                <FontIcon
                                    Grid.Column="1"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE8B2;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="Movies"
                                    FontSize="14"
                                    Margin="8,0,12,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- TV Shows -->
                        <Button
                            x:Name="FlyoutStreamTvShowsBtn"
                            Style="{StaticResource StreamingFlyoutItemButtonStyle}"
                            Tag="streamTvShows"
                            Click="OnStreamTvShowsFlyoutClick"
                            PointerEntered="OnFlyoutItemPointerEntered"
                            PointerPressed="OnFlyoutItemPointerPressed">
                            <Grid Height="36" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle
                                    x:Name="FlyoutTvShowsIndicator"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="16"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="1,0,0,0"
                                    Visibility="Collapsed" />

                                <FontIcon
                                    Grid.Column="1"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE7F4;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="TV Shows"
                                    FontSize="14"
                                    Margin="8,0,12,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- YouTube -->
                        <Button
                            x:Name="FlyoutStreamYouTubeBtn"
                            Style="{StaticResource StreamingFlyoutItemButtonStyle}"
                            Tag="streamYouTube"
                            Click="OnStreamYouTubeFlyoutClick"
                            PointerEntered="OnFlyoutItemPointerEntered"
                            PointerPressed="OnFlyoutItemPointerPressed">
                            <Grid Height="36" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle
                                    x:Name="FlyoutYouTubeIndicator"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="16"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="1,0,0,0"
                                    Visibility="Collapsed" />

                                <FontIcon
                                    Grid.Column="1"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE714;"
                                    FontSize="16"
                                    Foreground="{StaticResource YouTubeBrandBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="YouTube"
                                    FontSize="14"
                                    Margin="8,0,12,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Button>

                        <!-- Twitch -->
                        <Button
                            x:Name="FlyoutStreamTwitchBtn"
                            Style="{StaticResource StreamingFlyoutItemButtonStyle}"
                            Tag="streamTwitch"
                            Click="OnStreamTwitchFlyoutClick"
                            PointerEntered="OnFlyoutItemPointerEntered"
                            PointerPressed="OnFlyoutItemPointerPressed">
                            <Grid Height="36" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle
                                    x:Name="FlyoutTwitchIndicator"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="16"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="1,0,0,0"
                                    Visibility="Collapsed" />

                                <FontIcon
                                    Grid.Column="1"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE7FC;"
                                    FontSize="16"
                                    Foreground="{StaticResource TwitchBrandBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="Twitch"
                                    FontSize="14"
                                    Margin="8,0,12,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Flyout>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavHomeItem"
                    x:Uid="NavHome"
                    Content="Home"
                    Tag="home"
                    PointerEntered="OnNavItemPointerEntered"
                    PointerPressed="OnNavItemPointerPressed">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="HomeNavIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE80F;"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavMusicItem"
                    x:Uid="NavMusic"
                    Content="Music"
                    Tag="music"
                    PointerEntered="OnNavItemPointerEntered"
                    PointerPressed="OnNavItemPointerPressed">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="MusicNavIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE8D6;"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavVideoItem"
                    x:Uid="NavVideo"
                    Content="Videos"
                    Tag="videos"
                    PointerEntered="OnNavItemPointerEntered"
                    PointerPressed="OnNavItemPointerPressed">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="VideoNavIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE714;"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavPlaylistsItem"
                    x:Uid="NavPlaylists"
                    Content="Playlists"
                    Tag="playlists"
                    PointerEntered="OnNavItemPointerEntered"
                    PointerPressed="OnNavItemPointerPressed">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="PlaylistsNavIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE90B;"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NowPlayingNavItem"
                    x:Uid="NavNowPlaying"
                    Content="Now playing"
                    Tag="nowPlaying"
                    PointerEntered="OnNavItemPointerEntered"
                    PointerPressed="OnNavItemPointerPressed">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="NowPlayingNavIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE768;"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="PlaybackInfoBadge" Visibility="Collapsed">
                            <InfoBadge.IconSource>
                                <SymbolIconSource Symbol="Play" />
                            </InfoBadge.IconSource>
                        </InfoBadge>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem
                    x:Name="StreamingNavItem"
                    Content="Streaming"
                    Tag="streaming"
                    SelectsOnInvoked="False"
                    PointerEntered="OnNavItemPointerEntered"
                    PointerPressed="OnNavItemPointerPressed">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            x:Name="StreamingNavIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE93E;"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
                            Content="Music"
                            Tag="streamMusic"
                            SelectsOnInvoked="False"
                            PointerEntered="OnNavItemPointerEntered"
                            PointerPressed="OnNavItemPointerPressed">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE8D6;"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Movies"
                            Tag="streamMovies"
                            SelectsOnInvoked="False"
                            PointerEntered="OnNavItemPointerEntered"
                            PointerPressed="OnNavItemPointerPressed">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE8B2;"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="TV Shows"
                            Tag="streamTvShows"
                            SelectsOnInvoked="False"
                            PointerEntered="OnNavItemPointerEntered"
                            PointerPressed="OnNavItemPointerPressed">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE7F4;"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="YouTube"
                            Tag="streamYouTube"
                            SelectsOnInvoked="False"
                            PointerEntered="OnNavItemPointerEntered"
                            PointerPressed="OnNavItemPointerPressed">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE714;"
                                    Foreground="{StaticResource YouTubeBrandBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            Content="Twitch"
                            Tag="streamTwitch"
                            SelectsOnInvoked="False"
                            PointerEntered="OnNavItemPointerEntered"
                            PointerPressed="OnNavItemPointerPressed">
                            <NavigationViewItem.Icon>
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE7FC;"
                                    Foreground="{StaticResource TwitchBrandBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform Rotation="0" ScaleX="1" ScaleY="1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    Content="Settings"
                    Tag="settings"
                    AutomationProperties.Name="Settings"
                    PointerEntered="OnSettingsNavItemPointerEntered"
                    PointerExited="OnSettingsNavItemPointerExited">
                    <NavigationViewItem.Icon>
                        <AnimatedIcon x:Name="SettingsNavAnimatedIcon" Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Setting" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="UpdateInfoBadge" Value="1" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" x:FieldModifier="public" Margin="0" CacheSize="2" Navigated="OnContentFrameNavigated" Navigating="OnContentFrameNavigating" NavigationFailed="OnContentFrameNavigationFailed">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition />
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </NavigationView>

        <!-- Seamless AppTitleBar overlay at top of Row 0 -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            VerticalAlignment="Top"
            Background="{x:Null}"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited">
            <Grid.ColumnDefinitions>
                <!-- Column 0: 48px slot for Back / Hamburger button -->
                <ColumnDefinition x:Name="AppTitleBarLeftPaddingColumn" Width="48" />
                <!-- Column 1: Window drag region -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: System caption buttons -->
                <ColumnDefinition x:Name="AppTitleBarRightPaddingColumn" Width="140" />
            </Grid.ColumnDefinitions>

            <!-- Hit-testable drag region in Column 1 -->
            <Grid
                x:Name="DragRegion"
                Grid.Column="1"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <!-- App Title Brand Panel centered in the window header (Column 1 = drag region) -->
            <StackPanel
                x:Name="CenteredTitleBrandPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="4,0,4,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <Image x:Name="CenteredBrandIcon" Width="16" Height="16" UseLayoutRounding="True" Source="ms-appx:///Assets/Icons/Lumiere_Dark_Blue_small.png" VerticalAlignment="Center" Stretch="Uniform" />
                <TextBlock
                    x:Name="CenteredBrandText"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Lumière Media Player"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="240" />
            </StackPanel>

            <!-- Custom back button for video overlay mode -->
            <Button
                x:Name="VideoBackButton"
                Grid.Column="0"
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Click="OnVideoBackButtonClick"
                PointerEntered="OnVideoBackButtonPointerEntered"
                PointerExited="OnVideoBackButtonPointerExited"
                Visibility="Collapsed"
                AutomationProperties.Name="Back"
                ToolTipService.ToolTip="Back">
                <AnimatedIcon x:Name="VideoBackAnimatedIcon" Width="16" Height="16">
                    <AnimatedIcon.Source>
                        <animatedvisuals:AnimatedBackVisualSource />
                    </AnimatedIcon.Source>
                    <AnimatedIcon.FallbackIconSource>
                        <SymbolIconSource Symbol="Back" />
                    </AnimatedIcon.FallbackIconSource>
                </AnimatedIcon>
            </Button>
        </Grid>

        <!-- The Fullscreen Video Container -->
        <Grid x:Name="FullscreenVideoContainer" Canvas.ZIndex="50" Visibility="Collapsed" Background="#FF000000" Grid.RowSpan="2" RequestedTheme="Dark" DoubleTapped="OnVideoDoubleTapped" Tapped="OnVideoTapped" PointerWheelChanged="OnVideoPointerWheelChanged" SizeChanged="OnFullscreenVideoContainerSizeChanged">


            <!-- Fullscreen Controls Overlay — sits above video, fades in/out -->
            <Grid x:Name="FullscreenControlsOverlay" VerticalAlignment="Stretch" RequestedTheme="Dark">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- top bar: back button -->
                    <RowDefinition Height="*"/>      <!-- transparent middle (hit-test pass-through) -->
                    <RowDefinition Height="Auto"/>   <!-- bottom bar: transport + scrim -->
                </Grid.RowDefinitions>

                <!-- Top gradient scrim + back button (visible whenever transport bar / controls are visible) -->
                <Grid
                    x:Name="FullscreenTopBar"
                    Grid.Row="0"
                    Height="80"
                    PointerEntered="OnControlsPointerEntered"
                    PointerExited="OnControlsPointerExited">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#99000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Button
                        x:Name="FullscreenBackButton"
                        AutomationProperties.Name="Back"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,12,0,0"
                        Width="40" Height="36"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        RequestedTheme="Dark"
                        Foreground="White"
                        helpers:SpringAnimationHelper.EnableHoverSpring="True"
                        helpers:SpringAnimationHelper.HoverScale="1.08"
                        helpers:SpringAnimationHelper.PressScale="0.92"
                        PointerEntered="OnFullscreenBackButtonPointerEntered"
                        PointerExited="OnFullscreenBackButtonPointerExited"
                        Click="OnVideoBackButtonClick"
                        ToolTipService.ToolTip="Back">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3DFFFFFF" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White" />
                        </Button.Resources>
                        <AnimatedIcon x:Name="FullscreenBackAnimatedIcon" Width="16" Height="16" Foreground="White">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedBackVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Back" Foreground="White" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>
                </Grid>

                <!-- Middle: transparent, lets taps through to the video -->
                <Grid Grid.Row="1" Background="Transparent" IsHitTestVisible="False"/>

                <!-- Bottom transport controls slot -->
                <Grid Grid.Row="2" Background="Transparent">
                    <!-- TransportBar is reparented here at runtime via FullscreenTransportHost -->
                    <Border x:Name="FullscreenTransportHost" />
                </Grid>
            </Grid>

            <!-- Metadata Overlay -->
            <Border
                x:Name="FullscreenMetadataOverlay"
                x:FieldModifier="public"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24,64,24,96"
                Padding="20"
                CornerRadius="8"
                Visibility="Collapsed"
                Background="{ThemeResource FlyoutPresenterBackground}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                Canvas.ZIndex="60"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Border.BackgroundTransition>
                    <BrushTransition />
                </Border.BackgroundTransition>
                <Grid>
                    <Button x:Name="CloseFullscreenMetadataButton" x:FieldModifier="public" 
                            AutomationProperties.Name="Close metadata"
                            Margin="0,-12,-12,0"
                            Padding="4"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top" 
                            Background="Transparent"
                            BorderBrush="Transparent">
                        <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    
                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel Spacing="12" MaxWidth="350">
                    <TextBlock Text="File Information" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    
                    <Grid ColumnSpacing="20" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.Resolution, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Aspect Ratio" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.AspectRatio, Mode=OneWay, TargetNullValue='16:9'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Video Codec" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.Codec, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="HDR / Color" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.HdrFormat, Mode=OneWay, TargetNullValue='SDR'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Primary Audio" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.AudioFormat, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Audio Streams" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.AudioTracksSummary, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Subtitles" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.SubtitlesSummary, Mode=OneWay, TargetNullValue='None'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Bitrate / FPS" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.BitrateText, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.FrameRateText, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="File Format" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.ContainerFormat, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.FileSizeText, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="File Path" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.SourcePath, Mode=OneWay, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" MaxWidth="260" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Grid>

                    <!-- Divider between File Information and Internet Match -->
                    <MenuFlyoutSeparator Margin="0,8,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" x:Name="FullscreenMetadataDivider" x:FieldModifier="public" Visibility="Collapsed" />

                    <!-- Internet Metadata Match (syncs with normal mode's metadata side panel) -->
                    <StackPanel x:Name="FullscreenInternetMetadataPanel" x:FieldModifier="public" Spacing="12" Visibility="Collapsed" Width="300">
                        <TextBlock Text="Internet Match" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <ProgressRing x:Name="FullscreenInternetMetadataProgress" x:FieldModifier="public" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20,0,20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        
                        <Grid x:Name="FullscreenInternetMetadataContent" x:FieldModifier="public" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="FullscreenInternetMetadataPosterBorder" x:FieldModifier="public" Grid.Column="0" CornerRadius="8" VerticalAlignment="Top" Visibility="Collapsed">
                                <Image x:Name="FullscreenInternetMetadataPoster" x:FieldModifier="public" Width="90" Stretch="UniformToFill" MaxHeight="130" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock x:Name="FullscreenInternetMetadataTitle" x:FieldModifier="public" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="14" />
                                <TextBlock x:Name="FullscreenInternetMetadataOverview" x:FieldModifier="public" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="16" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="FullscreenInternetMetadataProvidersPanel" x:FieldModifier="public" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="FullscreenStreamingDetailsButton" x:FieldModifier="public" Content="Streaming" Padding="12,8" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" BorderBrush="Transparent" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>

            <!-- Fullscreen Edge Seek Overlays (10s & Exponential Skip) -->
            <Grid x:Name="FullscreenSeekOverlayHost" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                <!-- Seek Backward Overlay (Left) -->
                <Border
                    x:Name="FullscreenSeekBackOverlay"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="64,0,0,0"
                    Padding="28,20"
                    CornerRadius="32"
                    Background="#B31A1A1A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Opacity="0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xED3C;" FontSize="32" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock x:Name="FullscreenSeekBackText" Text="-10s" FontSize="28" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FullscreenSeekBackSubtext" Text="Seek Backward" FontSize="14" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- Seek Forward Overlay (Right) -->
                <Border
                    x:Name="FullscreenSeekForwardOverlay"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,64,0"
                    Padding="28,20"
                    CornerRadius="32"
                    Background="#B31A1A1A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Opacity="0">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock x:Name="FullscreenSeekForwardText" Text="+10s" FontSize="28" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xED3D;" FontSize="32" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FullscreenSeekForwardSubtext" Text="Seek Forward" FontSize="14" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <controls:TransportBar
            x:Name="TransportControls"
            Grid.Row="1"
            Canvas.ZIndex="590"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited"
            PointerWheelChanged="OnTransportControlsPointerWheelChanged"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom" />

        <!-- Mini Player View (CompactOverlay / PiP Mode) -->
        <Grid
            x:Name="MiniPlayerGrid"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="500"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            PointerMoved="OnMiniPlayerPointerMoved"
            PointerEntered="OnMiniPlayerPointerEntered"
            PointerExited="OnMiniPlayerPointerExited"
            Tapped="OnMiniPlayerTapped">

            <!-- Video Player Host (Video Mode) -->
            <MediaPlayerElement
                x:Name="MiniVideoPlayer"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AreTransportControlsEnabled="False"
                Stretch="Uniform"
                Visibility="Collapsed"
                AutoPlay="False" />

            <!-- Audio Artwork Host (Audio / Music Mode) -->
            <Grid x:Name="MiniAudioHost" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Ambient Blurred Art Background -->
                <Image
                    x:Name="MiniAudioArtBlurred"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Stretch="UniformToFill"
                    Opacity="0.30" />
                
                <!-- Dark Vignette over ambient art -->
                <Rectangle x:Name="MiniAudioVignette" Fill="#85000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Center Cover Art Card -->
                <Border
                    Width="105"
                    Height="105"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,36"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid CornerRadius="8">
                        <Image
                            x:Name="MiniAudioArt"
                            Stretch="UniformToFill"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Dimmer Overlay for readability -->
            <Grid
                x:Name="MiniControlsDimmer"
                Background="#50000000"
                Visibility="Collapsed"
                IsHitTestVisible="False" />

            <!-- Modern Fluent PiP Interactive Overlay -->
            <Grid x:Name="MiniOverlayControls">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Scrim & Header Bar -->
                <Grid x:Name="MiniHeaderGrid" Grid.Row="0" VerticalAlignment="Top" Height="36">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C0000000" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Track Info & Brand -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="12,0,8,0">
                        <TextBlock
                            x:Name="MiniTrackTitle"
                            Text="Track Title"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                        <TextBlock
                            x:Name="MiniArtistTitle"
                            Text="Artist Name"
                            FontSize="11"
                            Foreground="#B0FFFFFF"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                    </StackPanel>

                    <!-- Window Management Buttons: Minimize, Back to Normal Size, Close -->
                    <StackPanel
                        x:Name="MiniHeaderButtonsPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Height="32">
                        <!-- Minimize Button -->
                        <Button
                            x:Name="MiniMinimizeButton"
                            Click="OnMiniMinimizeClick"
                            Width="46"
                            Height="32"
                            Padding="0"
                            CornerRadius="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            ToolTipService.ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#25FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#15FFFFFF" />
                            </Button.Resources>
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="10"
                                Glyph="&#xE921;"
                                Foreground="White" />
                        </Button>

                        <!-- Maximize Button (Back to normal size) -->
                        <Button
                            x:Name="MiniExpandButton"
                            Click="OnMiniExitPipClick"
                            Width="46"
                            Height="32"
                            Padding="0"
                            CornerRadius="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            ToolTipService.ToolTip="Maximize"
                            AutomationProperties.Name="Maximize">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#25FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#15FFFFFF" />
                            </Button.Resources>
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="10"
                                Glyph="&#xE922;"
                                Foreground="White" />
                        </Button>

                        <!-- Close Button -->
                        <Button
                            x:Name="MiniCloseButton"
                            Click="OnMiniCloseClick"
                            Width="46"
                            Height="32"
                            Padding="0"
                            CornerRadius="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            ToolTipService.ToolTip="Close"
                            AutomationProperties.Name="Close">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C4101F" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            </Button.Resources>
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="10"
                                Glyph="&#xE711;"
                                Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Center Floating Playback Controls Dock (10s Back, Play/Pause, 10s Forward) -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border
                        CornerRadius="24"
                        Background="#D0141620"
                        BorderBrush="#38FFFFFF"
                        BorderThickness="1"
                        Padding="14,8"
                        Translation="0,2,16">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="14"
                            VerticalAlignment="Center">

                            <!-- Seek 10s Backward Button -->
                            <Button
                                Click="OnMiniSkipBackwardClick"
                                Width="36"
                                Height="36"
                                Padding="0"
                                CornerRadius="18"
                                Background="#26FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                Style="{StaticResource TransportIconButtonStyle}"
                                ToolTipService.ToolTip="Seek 10s backward"
                                AutomationProperties.Name="Seek 10 seconds back"
                                helpers:SpringAnimationHelper.EnableHoverSpring="True"
                                helpers:SpringAnimationHelper.HoverScale="1.08">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="15" Glyph="&#xED3C;" Foreground="White" />
                            </Button>

                            <!-- Play/Pause Button -->
                            <Button
                                x:Name="MiniPlayPauseButton"
                                Click="OnMiniPlayPauseClick"
                                Width="44"
                                Height="44"
                                Padding="0"
                                CornerRadius="22"
                                Background="#30FFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                ToolTipService.ToolTip="Play / Pause"
                                AutomationProperties.Name="Play or Pause"
                                helpers:SpringAnimationHelper.EnableHoverSpring="True"
                                helpers:SpringAnimationHelper.HoverScale="1.08"
                                helpers:SpringAnimationHelper.PressScale="0.92">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#45FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#25FFFFFF" />
                                </Button.Resources>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <AnimatedVisualPlayer
                                        x:Name="MiniPlayerVisual"
                                        AutoPlay="False"
                                        Width="40"
                                        Height="40"
                                        Opacity="0.4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <FontIcon
