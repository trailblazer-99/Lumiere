<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LumiereMediaPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LumiereMediaPlayer.Controls"
    xmlns:helpers="using:LumiereMediaPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LumiereMediaPlayer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    mc:Ignorable="d"
    Title="Lumière Media Player">


    <Grid x:Name="RootGrid" Loaded="OnWindowLoaded" KeyDown="OnRootGridKeyDown" PointerWheelChanged="OnRootGridPointerWheelChanged" PointerMoved="OnRootGridPointerMoved" PointerPressed="OnRootGridPointerPressed" PointerReleased="OnRootGridPointerReleased" PointerCanceled="OnRootGridPointerCanceled" PointerCaptureLost="OnRootGridPointerCanceled">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left Pane Navigation and Content Frame -->
        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsPaneToggleButtonVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged"
            BackRequested="OnBackRequested"
            PaneOpened="OnNavigationPaneOpened"
            PaneClosed="OnNavigationPaneClosed"
            PaneOpening="OnNavigationPaneOpening"
            PaneClosing="OnNavigationPaneClosing"
            DisplayModeChanged="OnNavigationDisplayModeChanged">

            <NavigationView.PaneHeader>
                <Grid Height="40" VerticalAlignment="Center" Margin="6,0,0,0">
                    <StackPanel x:Name="PaneBrandPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image Width="18" Height="18" Source="ms-appx:///Assets/LumiereIcon.png" VerticalAlignment="Center" Stretch="Uniform" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Lumière Media Player"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="AppSearchBox"
                    PlaceholderText="Search music, videos, streaming..."
                    QueryIcon="Find"
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchQuerySubmitted"
                    SuggestionChosen="OnSearchSuggestionChosen" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentMargin">0</Thickness>
                <x:Double x:Key="NavigationViewHeaderMinHeight">0</x:Double>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Icon="Home" Tag="home" helpers:SpringAnimationHelper.EnableItemIconSpring="True" />
                <NavigationViewItem Content="Music" Icon="MusicInfo" Tag="music" helpers:SpringAnimationHelper.EnableItemIconSpring="True" />
                <NavigationViewItem Content="Videos" Icon="Video" Tag="videos" helpers:SpringAnimationHelper.EnableItemIconSpring="True" />
                <NavigationViewItem Content="Playlists" Icon="List" Tag="playlists" helpers:SpringAnimationHelper.EnableItemIconSpring="True" />
                <NavigationViewItem
                    x:Name="NowPlayingNavItem"
                    Content="Now playing"
                    Icon="Play"
                    Tag="nowPlaying"
                    helpers:SpringAnimationHelper.EnableItemIconSpring="True">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="PlaybackInfoBadge" Visibility="Collapsed">
                            <InfoBadge.IconSource>
                                <SymbolIconSource Symbol="Play" />
                            </InfoBadge.IconSource>
                        </InfoBadge>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Streaming" Tag="streaming" helpers:SpringAnimationHelper.EnableItemIconSpring="True">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE93E;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Music" Tag="streamMusic" helpers:SpringAnimationHelper.EnableItemIconSpring="True">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8D6;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Movies" Tag="streamMovies" helpers:SpringAnimationHelper.EnableItemIconSpring="True">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8B2;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="TV Shows" Tag="streamTvShows" helpers:SpringAnimationHelper.EnableItemIconSpring="True">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F4;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="YouTube" Tag="streamYouTube" helpers:SpringAnimationHelper.EnableItemIconSpring="True">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE714;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Twitch" Tag="streamTwitch" helpers:SpringAnimationHelper.EnableItemIconSpring="True">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7FC;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" x:FieldModifier="public" Margin="0" CacheSize="2" Navigated="OnContentFrameNavigated" Navigating="OnContentFrameNavigating" NavigationFailed="OnContentFrameNavigationFailed">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- Seamless AppTitleBar overlay at top of Row 0 -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            VerticalAlignment="Top"
            Background="{x:Null}"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited">
            <Grid.ColumnDefinitions>
                <!-- Column 0: 48px slot for Back / Hamburger button -->
                <ColumnDefinition Width="48" />
                <!-- Column 1: Window drag region -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: System caption buttons -->
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <!-- Hit-testable drag region in Column 1 -->
            <Grid
                x:Name="DragRegion"
                Grid.Column="1"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <!-- App Title Brand Panel centered in the window header -->
            <StackPanel
                x:Name="CenteredTitleBrandPanel"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0,0,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <Image Width="18" Height="18" Source="ms-appx:///Assets/LumiereIcon.png" VerticalAlignment="Center" Stretch="Uniform" />
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Lumière Media Player"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Custom back button for video overlay mode -->
            <Button
                x:Name="VideoBackButton"
                Grid.Column="0"
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#801F1F1F"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Foreground="White"
                Click="OnVideoBackButtonClick"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Back">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#801F1F1F" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B31F1F1F" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CC1F1F1F" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
                <FontIcon FontSize="13" Glyph="&#xE72B;" Foreground="White" />
            </Button>
        </Grid>

        <!-- The Fullscreen Video Container -->
        <Grid x:Name="FullscreenVideoContainer" Visibility="Collapsed" Background="#FF000000" Grid.RowSpan="2" RequestedTheme="Dark" DoubleTapped="OnVideoDoubleTapped" Tapped="OnVideoTapped" PointerWheelChanged="OnVideoPointerWheelChanged" SizeChanged="OnFullscreenVideoContainerSizeChanged">


            <!-- Fullscreen Controls Overlay — sits above video, fades in/out -->
            <Grid x:Name="FullscreenControlsOverlay" VerticalAlignment="Stretch" RequestedTheme="Dark">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- top bar: back button -->
                    <RowDefinition Height="*"/>      <!-- transparent middle (hit-test pass-through) -->
                    <RowDefinition Height="Auto"/>   <!-- bottom bar: transport + scrim -->
                </Grid.RowDefinitions>

                <!-- Top gradient scrim + back button (visible whenever transport bar / controls are visible) -->
                <Grid
                    x:Name="FullscreenTopBar"
                    Grid.Row="0"
                    Height="80">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#99000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Button
                        x:Name="FullscreenBackButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,12,0,0"
                        Width="40" Height="36"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        RequestedTheme="Dark"
                        Foreground="White"
                        helpers:SpringAnimationHelper.EnableHoverSpring="True"
                        helpers:SpringAnimationHelper.HoverScale="1.08"
                        helpers:SpringAnimationHelper.PressScale="0.92"
                        PointerEntered="OnControlsPointerEntered"
                        PointerExited="OnControlsPointerExited"
                        Click="OnVideoBackButtonClick"
                        ToolTipService.ToolTip="Back">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3DFFFFFF" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="White" />
                        </Button.Resources>
                        <FontIcon
                            FontSize="16"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE72B;"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- Middle: transparent, lets taps through to the video -->
                <Grid Grid.Row="1" Background="Transparent" IsHitTestVisible="False"/>

                <!-- Bottom transport controls slot -->
                <Grid Grid.Row="2" Background="Transparent">
                    <!-- TransportBar is reparented here at runtime via FullscreenTransportHost -->
                    <Border x:Name="FullscreenTransportHost" />
                </Grid>
            </Grid>

            <!-- Metadata Overlay -->
            <Border
                x:Name="FullscreenMetadataOverlay"
                x:FieldModifier="public"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24"
                Padding="20"
                CornerRadius="8"
                Visibility="Collapsed"
                Background="#CC1F1F1F">
                <Border.BackgroundTransition>
                    <BrushTransition />
                </Border.BackgroundTransition>
                <Grid>
                    <Button x:Name="CloseFullscreenMetadataButton" x:FieldModifier="public" 
                            Margin="0,-12,-12,0"
                            Padding="4"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top" 
                            Background="Transparent"
                            BorderBrush="Transparent">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="White" />
                    </Button>
                    
                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel Spacing="12" MaxWidth="350">
                    <TextBlock Text="File Information" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="White" />
                    
                    <Grid ColumnSpacing="20" RowSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" Foreground="#A0A0A0" FontSize="11" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.Resolution, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Aspect Ratio" Foreground="#A0A0A0" FontSize="11" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.AspectRatio, Mode=OneWay, TargetNullValue='16:9'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Video Codec" Foreground="#A0A0A0" FontSize="11" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.Codec, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="HDR / Color" Foreground="#A0A0A0" FontSize="11" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.HdrFormat, Mode=OneWay, TargetNullValue='SDR'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Primary Audio" Foreground="#A0A0A0" FontSize="11" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.AudioFormat, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Audio Streams" Foreground="#A0A0A0" FontSize="11" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.AudioTracksSummary, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Subtitles" Foreground="#A0A0A0" FontSize="11" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.SubtitlesSummary, Mode=OneWay, TargetNullValue='None'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Bitrate / FPS" Foreground="#A0A0A0" FontSize="11" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.BitrateText, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="•" FontSize="11" Foreground="#66FFFFFF" />
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.FrameRateText, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="File Format" Foreground="#A0A0A0" FontSize="11" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.ContainerFormat, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="•" FontSize="11" Foreground="#66FFFFFF" />
                            <TextBlock Text="{x:Bind Playback.CurrentTrack.FileSizeText, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="File Path" Foreground="#A0A0A0" FontSize="11" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind Playback.CurrentTrack.SourcePath, Mode=OneWay, TargetNullValue='Unknown'}" FontSize="11" FontWeight="SemiBold" MaxWidth="260" TextWrapping="Wrap" Foreground="White" />
                    </Grid>

                    <!-- Divider between File Information and Internet Match -->
                    <MenuFlyoutSeparator Margin="0,8,0,4" Background="#33FFFFFF" x:Name="FullscreenMetadataDivider" x:FieldModifier="public" Visibility="Collapsed" />

                    <!-- Internet Metadata Match (syncs with normal mode's metadata side panel) -->
                    <StackPanel x:Name="FullscreenInternetMetadataPanel" x:FieldModifier="public" Spacing="12" Visibility="Collapsed" Width="300">
                        <TextBlock Text="Internet Match" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="White" />
                        <ProgressRing x:Name="FullscreenInternetMetadataProgress" x:FieldModifier="public" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20,0,20" Foreground="White" />
                        
                        <Grid x:Name="FullscreenInternetMetadataContent" x:FieldModifier="public" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" VerticalAlignment="Top">
                                <Image x:Name="FullscreenInternetMetadataPoster" x:FieldModifier="public" Stretch="UniformToFill" MaxHeight="130" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock x:Name="FullscreenInternetMetadataTitle" x:FieldModifier="public" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" FontSize="14" />
                                <TextBlock x:Name="FullscreenInternetMetadataOverview" x:FieldModifier="public" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#A0A0A0" LineHeight="15" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="FullscreenInternetMetadataProvidersPanel" x:FieldModifier="public" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="FullscreenStreamingDetailsButton" x:FieldModifier="public" Content="Streaming" Padding="12,8" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{ThemeResource SystemAccentColor}" Foreground="White" BorderBrush="Transparent" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>

            <!-- Fullscreen Edge Seek Overlays (10s & Exponential Skip) -->
            <Grid x:Name="FullscreenSeekOverlayHost" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                <!-- Seek Backward Overlay (Left) -->
                <Border
                    x:Name="FullscreenSeekBackOverlay"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="64,0,0,0"
                    Padding="28,20"
                    CornerRadius="32"
                    Background="#B31A1A1A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Opacity="0">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xED3C;" FontSize="28" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock x:Name="FullscreenSeekBackText" Text="-10s" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FullscreenSeekBackSubtext" Text="Seek Backward" FontSize="13" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- Seek Forward Overlay (Right) -->
                <Border
                    x:Name="FullscreenSeekForwardOverlay"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,64,0"
                    Padding="28,20"
                    CornerRadius="32"
                    Background="#B31A1A1A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Opacity="0">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock x:Name="FullscreenSeekForwardText" Text="+10s" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xED3D;" FontSize="28" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FullscreenSeekForwardSubtext" Text="Seek Forward" FontSize="13" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <controls:TransportBar
            x:Name="TransportControls"
            Grid.Row="1"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited"
            PointerWheelChanged="OnTransportControlsPointerWheelChanged"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom" />

        <!-- Mini Player View (CompactOverlay Mode) -->
        <Grid
            x:Name="MiniPlayerGrid"
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="#FF111111"
            Visibility="Collapsed"
            PointerMoved="OnMiniPlayerPointerMoved"
            PointerEntered="OnMiniPlayerPointerEntered"
            PointerExited="OnMiniPlayerPointerExited">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <!-- Custom Circular Icon Button Style -->
                <Style x:Key="MiniIconButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Width" Value="44"/>
                    <Setter Property="Height" Value="44"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="22" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    
                                    <!-- Hover background circle -->
                                    <Ellipse x:Name="HoverCircle" Fill="White" Opacity="0.0" Width="40" Height="40"/>
                                    
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverCircle" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.1" />
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1" />
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverCircle" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.1" />
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.1" />
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.1" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverCircle" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.05" />
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.05" />
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.05" />
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Large Custom Play/Pause Button Style -->
                <Style x:Key="MiniPlayPauseButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Width" Value="64"/>
                    <Setter Property="Height" Value="64"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    
                                    <!-- Outer Gradient Ring -->
                                    <Border x:Name="OuterRing"
                                            Width="60"
                                            Height="60"
                                            CornerRadius="30"
                                            BorderThickness="3.5">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFFF7E40" Offset="0.0" />
                                                <GradientStop Color="#FFFF2D55" Offset="0.5" />
                                                <GradientStop Color="#FF8E52E8" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        
                                        <!-- Inner Circle -->
                                        <Grid x:Name="InnerCircle"
                                              CornerRadius="27"
                                              Background="#FF2A2A2D">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1" />
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.1" />
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.1" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.05" />
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.05" />
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!-- Center Control Area -->
            <Grid Grid.Row="1">
                <!-- Video Player (Video mode) -->
                <MediaPlayerElement x:Name="MiniVideoPlayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AreTransportControlsEnabled="False" Stretch="Uniform" Visibility="Collapsed" AutoPlay="False" />
                
                <!-- Album Art (Audio mode) -->
                <Image x:Name="MiniAudioArt" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="UniformToFill" Opacity="0.3" Visibility="Collapsed" />
                
                <!-- Dimming overlay and control buttons wrapper -->
                <Grid x:Name="MiniOverlayControls">
                    <!-- Dimming overlay to make controls stand out -->
                    <Grid x:Name="MiniControlsDimmer" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="False" />

                    <!-- Center Control Buttons -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        
                        <!-- Previous Button -->
                        <Button
                            Click="OnMiniPreviousClick"
                            Style="{StaticResource MiniIconButtonStyle}"
                            ToolTipService.ToolTip="Previous">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="20" Glyph="&#xE892;" Foreground="White" />
                        </Button>

                        <!-- Play/Pause Button -->
                        <Button
                            Style="{StaticResource MiniPlayPauseButtonStyle}"
                            Click="OnMiniPlayPauseClick"
                            ToolTipService.ToolTip="Play">
                            <FontIcon
                                x:Name="MiniPlayPauseIcon"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="20"
                                Glyph="&#xE768;"
                                Foreground="White"
                                Margin="2,0,0,0" />
                        </Button>

                        <!-- Next Button -->
                        <Button
                            Click="OnMiniNextClick"
                            Style="{StaticResource MiniIconButtonStyle}"
                            ToolTipService.ToolTip="Next">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="20" Glyph="&#xE893;" Foreground="White" />
                        </Button>
                    </StackPanel>

                    <!-- Revert / Exit PiP Button in Bottom Right -->
                    <Button
                        Click="OnMiniExitPipClick"
                        Style="{StaticResource MiniIconButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        ToolTipService.ToolTip="Exit Picture in Picture">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" Glyph="&#xE93A;" Foreground="White" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
