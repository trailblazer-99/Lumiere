                            Padding="0"
                            Margin="0"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Style="{StaticResource TransportIconButtonStyle}"
                            ToolTipService.ToolTip="Expand"
                            AutomationProperties.Name="Expand"
                            helpers:SpringAnimationHelper.EnableHoverSpring="True"
                            helpers:SpringAnimationHelper.HoverScale="1.08"
                            helpers:SpringAnimationHelper.PressScale="0.92">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Glyph="&#xE93A;"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Button>

                        <Button
                            x:Name="MiniMinimizeButton"
                            Click="OnMiniMinimizeClick"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="MiniCloseButton"
                            Click="OnMiniCloseClick"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- Playback Controls (No Pill Shape) -->
                <Grid
                    x:Name="MiniTransportDockGrid"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <!-- Seek 10s Backward / Previous Track Button -->
                        <Button
                            x:Name="MiniPrevOrSkipBackButton"
                            Click="OnMiniSkipBackwardClick"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            Background="#38000000"
                            BorderThickness="0"
                            Style="{StaticResource TransportIconButtonStyle}"
                            ToolTipService.ToolTip="Seek 10s backward"
                            AutomationProperties.Name="Seek 10 seconds back"
                            helpers:SpringAnimationHelper.EnableHoverSpring="True"
                            helpers:SpringAnimationHelper.HoverScale="1.1"
                            helpers:SpringAnimationHelper.PressScale="0.92">
                            <FontIcon x:Name="MiniPrevOrSkipBackIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xED3C;" Foreground="White" />
                        </Button>

                        <!-- Play/Pause Button (Uses CleanPlayPauseButtonStyle identical to player) -->
                        <Button
                            x:Name="MiniPlayPauseButton"
                            Click="OnMiniPlayPauseClick"
                            AutomationProperties.Name="Play"
                            ToolTipService.ToolTip="Play"
                            Style="{StaticResource CleanPlayPauseButtonStyle}"
                            helpers:SpringAnimationHelper.EnableHoverSpring="True"
                            helpers:SpringAnimationHelper.HoverScale="1.08"
                            helpers:SpringAnimationHelper.PressScale="0.92">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <AnimatedVisualPlayer
                                    x:Name="MiniPlayerVisual"
                                    AutoPlay="False"
                                    Width="44"
                                    Height="44"
                                    Opacity="0.4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    x:Name="MiniPlayPauseIcon"
                                    FontSize="16"
                                    Glyph="&#xE768;"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Seek 10s Forward / Next Track Button -->
                        <Button
                            x:Name="MiniNextOrSkipForwardButton"
                            Click="OnMiniSkipForwardClick"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            Background="#38000000"
                            BorderThickness="0"
                            Style="{StaticResource TransportIconButtonStyle}"
                            ToolTipService.ToolTip="Seek 10s forward"
                            AutomationProperties.Name="Seek 10 seconds forward"
                            helpers:SpringAnimationHelper.EnableHoverSpring="True"
                            helpers:SpringAnimationHelper.HoverScale="1.1"
                            helpers:SpringAnimationHelper.PressScale="0.92">
                            <FontIcon x:Name="MiniNextOrSkipForwardIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xED3D;" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Bottom Timeline & Scrubber Bar (No Pill Shape) -->
                <Grid
                    x:Name="MiniPositionHost"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Margin="12,0,12,8"
                    IsHitTestVisible="True">
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Elapsed Position Timestamp -->
                        <TextBlock
                            x:Name="MiniPositionText"
                            Grid.Column="0"
                            Text="00:00"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            VerticalAlignment="Center" />

                        <!-- Seek Slider -->
                        <Slider
                            x:Name="MiniPositionSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            VerticalAlignment="Center"
                            Margin="0,-2,0,-2"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="OnMiniSliderValueChanged"
                            PointerPressed="OnMiniSliderPointerPressed"
                            PointerReleased="OnMiniSliderPointerReleased" />

                        <!-- Duration Timestamp -->
                        <TextBlock
                            x:Name="MiniDurationText"
                            Grid.Column="2"
                            Text="00:00"
                            FontSize="11"
                            FontWeight="Normal"
                            Foreground="#B0FFFFFF"
                            VerticalAlignment="Center" />

                        <!-- Sound Mute/Unmute Button -->
                        <Button
                            x:Name="MiniVolumeButton"
                            Grid.Column="3"
                            Click="OnMiniVolumeClick"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="15"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Mute / Unmute"
                            AutomationProperties.Name="Mute or Unmute"
                            helpers:SpringAnimationHelper.EnableHoverSpring="True"
                            helpers:SpringAnimationHelper.HoverScale="1.1"
                            helpers:SpringAnimationHelper.PressScale="0.92">
                            <FontIcon
                                x:Name="MiniVolumeIcon"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="13"
                                Glyph="&#xE767;"
                                Foreground="White" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Full-Window App Lock Overlay (Windows Hello Biometrics & PIN) -->
        <Grid
            x:Name="AppLockOverlay"
            Grid.RowSpan="2"
            Canvas.ZIndex="9999"
            Visibility="Collapsed"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <!-- Deep Acrylic / Ambient Glow Backdrop -->
            <Border
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />

            <!-- Lock Card Center Container -->
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420"
                Padding="32,36"
                CornerRadius="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <!-- App Logo and Lock Icon Composition -->
                    <Grid Width="72" Height="72" HorizontalAlignment="Center">
                        <Border
                            Width="72"
                            Height="72"
                            CornerRadius="36"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}" />
                        <FontIcon
                            FontSize="32"
                            Glyph="&#xE8D7;"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!-- Text Branding -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock
                            Text="Lumière is Locked"
                            FontSize="22"
                            FontWeight="SemiBold"
                            TextAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="Use Windows Hello face, fingerprint, or your Windows PIN to unlock."
                            FontSize="14"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Status / Error Feedback Message -->
                    <TextBlock
                        x:Name="AppLockStatusMessage"
                        Text="Awaiting authentication..."
                        FontSize="12"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="Collapsed" />

                    <!-- Action Buttons -->
                    <StackPanel Spacing="8" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <Button
                            x:Name="AppLockUnlockButton"
                            Content="Unlock with Windows Hello"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            CornerRadius="8"
                            helpers:SpringAnimationHelper.EnableHoverSpring="True"
                            helpers:SpringAnimationHelper.HoverScale="1.03"
                            Click="OnAppLockUnlockClicked" />

                        <Button
                            x:Name="AppLockExitButton"
                            Content="Exit Lumière"
                            HorizontalAlignment="Stretch"
                            Height="34"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            helpers:SpringAnimationHelper.EnableHoverSpring="True"
                            helpers:SpringAnimationHelper.HoverScale="1.03"
                            Click="OnAppLockExitClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

                <!-- Fullscreen Dimming Scrim for Smooth Transition -->
        <Border
            x:Name="FullscreenDimScrim"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="550"
            Background="Black"
            Opacity="0"
            Visibility="Collapsed"
            IsHitTestVisible="False" />

        <!-- Page Selection Ribbon Overlay Host (renders in front of FloatingVideoContainer Z:10) -->
        <Grid
            x:Name="PageRibbonHost"
            x:FieldModifier="public"
            Grid.Row="0"
            Canvas.ZIndex="65"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            IsHitTestVisible="True" />

        <!-- Elevated Netflix-Style Video Hover Preview Host -->
        <controls:VideoHoverPreviewHost
            x:Name="VideoHoverPreview"
            Grid.RowSpan="2"
            Canvas.ZIndex="600"
            Visibility="Collapsed" />

        <!-- TV Episode Video Card Queue Overlay -->
        <controls:TvEpisodeQueueOverlay
            x:Name="TvEpisodeQueueOverlay"
            x:FieldModifier="public"
            Grid.RowSpan="2"
            Canvas.ZIndex="580"
            Visibility="Collapsed" />

        <!-- Floating Bottom Pop-up Toast Host (e.g. "No updates") -->
        <Border
            x:Name="BottomToastHost"
            Grid.Row="0"
            Canvas.ZIndex="700"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            Padding="16,10,12,10"
            Opacity="0"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="BottomToastIcon" Grid.Column="0" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="BottomToastTitle" Text="No updates" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="BottomToastSubtitle" Text="— You're on the latest version" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="6" CornerRadius="4" VerticalAlignment="Center"
                        Click="OnDismissBottomToastClicked" ToolTipService.ToolTip="Dismiss">
                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
